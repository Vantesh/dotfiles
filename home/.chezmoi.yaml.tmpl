{{- $interactive := not (or (eq (env "NOCONFIRM") "1") (env "CI") (env "GITHUB_ACTIONS") (env "GITLAB_CI") (env "CODESPACES")) -}}

{{- /* Defaults */ -}}
{{- $personal := get . "personal" | default false -}}

{{- /* Arch-only setup */ -}}
{{- $distroFamily := "" -}}
{{- if .chezmoi.osRelease -}}
  {{- $distroFamily = default .chezmoi.osRelease.id (index .chezmoi.osRelease "idLike") | lower -}}
{{- end -}}
{{- if not (contains "arch" $distroFamily) -}}
  {{- writeToStdout "ERROR: This dotfiles repo only supports Arch Linux and Arch-based distros.\n" -}}
  {{- exit 1 -}}
{{- end -}}
{{- $distroFamily = "arch" -}}

{{- /* Interactive prompts */ -}}
{{- if $interactive -}}
  {{- $personal = promptBoolOnce . "personal" "Is this a personal setup" false -}}
{{- end -}}

{{- if and $interactive $personal -}}
  {{- writeToStdout "Personal setup uses Bitwarden and provisions this system. First-time Secure Boot enrollment requires UEFI Setup Mode with Secure Boot disabled. Enable Secure Boot only after applying successfully.\n" -}}
{{- end -}}

data:
  personal: {{ $personal }}
  distroFamily: {{ $distroFamily | quote }}

scriptEnv:
  PERSONAL: {{ ternary "1" "0" $personal | quote }}
  DISTRO_FAMILY: {{ $distroFamily | quote }}
  DISTRO: {{ .chezmoi.osRelease.id | quote }}


edit:
  command: zeditor
  args: ["--wait"]

merge:
  command: meld
  args: ["{{ "{{ .Target }}" }}", "{{ "{{ .Destination }}" }}"]

diff:
  pager: delta
  exclude: [scripts]
