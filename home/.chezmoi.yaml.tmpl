{{- $interactive := not (or (eq (env "NOCONFIRM") "1") (env "CI") (env "GITHUB_ACTIONS") (env "GITLAB_CI") (env "CODESPACES")) -}}
{{- $skipPackages := eq (env "SKIP_PACKAGES") "1" -}}

{{- /* Defaults */ -}}
{{- $personal := get . "personal" | default false -}}

{{- $setupSnapper :=  not $skipPackages -}}
{{- $setupHibernation := not $skipPackages -}}
{{- $setupSecureBoot := get . "setupSecureBoot" | default false -}}
{{- $preserveFirmwareSecureBootKeys := get . "preserveFirmwareSecureBootKeys" | default true -}}
{{- if hasKey . "preserveFirmwareSecureBootKeys" -}}
  {{- $preserveFirmwareSecureBootKeys = get . "preserveFirmwareSecureBootKeys" -}}
{{- end -}}

{{- $installDrivers := not $skipPackages -}}

{{- /* Arch-only setup */ -}}
{{- $distroFamily := "" -}}
{{- if .chezmoi.osRelease -}}
  {{- $distroFamily = default .chezmoi.osRelease.id (index .chezmoi.osRelease "idLike") | lower -}}
{{- end -}}
{{- if not (contains "arch" $distroFamily) -}}
  {{- writeToStdout "\n\033[1;31mERROR:\033[0m This dotfiles repo only supports Arch Linux and Arch-based distros.\n\n" -}}
  {{- exit 1 -}}
{{- end -}}
{{- $distroFamily = "arch" -}}

{{- /* Interactive prompts */ -}}
{{- if $interactive -}}
  {{- $personal = promptBoolOnce . "personal" "Is this a personal setup" false -}}
  {{- if $personal -}}
    {{- writeToStdout "\n\033[1;32mINFO:\033[0m Personal setup enables Bitwarden-backed private configuration.\n\n" -}}
  {{- end -}}

  {{- $setupSnapper = promptBool "Setup Snapper snapshots (Y/n)" true -}}
  {{- $setupHibernation = promptBool "Setup hibernation (Y/n)" true -}}
  {{- $setupSecureBoot = promptBool "Setup Limine Secure Boot (writes firmware keys) (y/N)" false -}}
  {{- if $setupSecureBoot -}}
    {{- $preserveFirmwareSecureBootKeys = promptBool "Preserve firmware Secure Boot certificates (Y/n)" $preserveFirmwareSecureBootKeys -}}
    {{- writeToStdout "\n\033[1;33mWARN:\033[0m First-time key enrollment requires UEFI Setup Mode with Secure Boot disabled. Enable Secure Boot only after applying successfully.\n\n" -}}
  {{- end -}}

  {{- if not $skipPackages -}}
    {{- $installDrivers = promptBool "Install drivers (Y/n)" true -}}
  {{- end -}}

  {{- writeToStdout "\n\033[1;32mTIP:\033[0m Reconfigure saved choices with \033[1mchezmoi init --prompt\033[0m\n\n" -}}
{{- end -}}

data:
  personal: {{ $personal }}
  distroFamily: {{ $distroFamily | quote }}
  setupSnapper: {{ $setupSnapper }}
  setupHibernation: {{ $setupHibernation }}
  setupSecureBoot: {{ $setupSecureBoot }}
  preserveFirmwareSecureBootKeys: {{ $preserveFirmwareSecureBootKeys }}

  installDrivers: {{ $installDrivers }}

scriptEnv:
  PERSONAL: {{ ternary "1" "0" $personal | quote }}
  DISTRO_FAMILY: {{ $distroFamily | quote }}
  DISTRO: {{ .chezmoi.osRelease.id | quote }}
  SETUP_SNAPPER: {{ ternary "1" "0" $setupSnapper | quote }}
  SETUP_HIBERNATION: {{ ternary "1" "0" $setupHibernation | quote }}
  SETUP_SECURE_BOOT: {{ ternary "1" "0" $setupSecureBoot | quote }}
  PRESERVE_FIRMWARE_SECURE_BOOT_KEYS: {{ ternary "1" "0" $preserveFirmwareSecureBootKeys | quote }}

  INSTALL_DRIVERS: {{ ternary "1" "0" $installDrivers | quote }}


merge:
  command: meld
  args: ["{{ "{{ .Destination }}" }}", "{{ "{{ .Source }}" }}", "{{ "{{ .Target }}" }}"]

diff:
  pager: delta
  exclude: [scripts]
