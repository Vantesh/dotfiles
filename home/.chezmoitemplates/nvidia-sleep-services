# mise/config.nvidia-sleep.toml: {{ include "../mise/config.nvidia-sleep.toml" | sha256sum }}
{{- $config := include "../mise/config.nvidia-sleep.toml" | fromToml }}
# Invoked only inside the existing NVIDIA branch after hibernation setup.
# Keep the hooks idle; systemd's sleep transactions execute their oneshots.
(
  temp_dir=$(mktemp -d)
  trap 'rm -rf -- "$temp_dir"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  cd "$temp_dir" || exit 1
  mkdir mise
  printf 'min_version = %s\n' '{{ $config.min_version | toJson }}' >mise/config.nvidia-sleep.toml
  available=false

{{ range $unit, $declaration := $config.bootstrap.services }}
  if ! load_state=$(systemctl show --property=LoadState --value -- {{ $unit | quote }}); then
    die "Failed to inspect {{ $unit }}"
  fi
  case "$load_state" in
    not-found)
      log SKIP "{{ $unit }} not available"
      ;;
    loaded|masked)
      available=true
      cat >>mise/config.nvidia-sleep.toml <<'UNIT'
[bootstrap.services.{{ $unit | toJson }}]
{{ $declaration | toToml }}
UNIT
      ;;
    *)
      die "Cannot apply {{ $unit }}: unexpected LoadState=$load_state"
      ;;
  esac
{{ end }}

  if [[ "$available" == false ]]; then
    log SKIP "No NVIDIA sleep units are available"
    exit 0
  fi

  # Discover only the selected NVIDIA units, never the baseline services.
  if ! env -u MISE_CONFIG_FILE -u MISE_GLOBAL_CONFIG_FILE -u MISE_SYSTEM_CONFIG_FILE \
    -u MISE_OVERRIDE_CONFIG_FILENAMES \
    MISE_CONFIG_DIR=/dev/null MISE_SYSTEM_CONFIG_DIR=/dev/null \
    MISE_AUTO_ENV=false MISE_CEILING_PATHS="${PWD%/*}" \
    MISE_TRUSTED_CONFIG_PATHS="$PWD/mise" \
    mise --env nvidia-sleep bootstrap services apply --yes; then
    die "Failed to apply NVIDIA sleep services with mise"
  fi
)
