# vim: ft=sshconfig

Host *
    AddKeysToAgent yes
    HashKnownHosts no
    Compression yes
    ConnectionAttempts 5
    ServerAliveInterval 60

Host github.com
    HostName github.com
    User git

Host gitlab.com
    HostName gitlab.com
    User git

Host gist.github.com
  HostName gist.github.com
