if not status is-interactive
    return
end

if not type -q fisher
    set -l fisher_version {{ .externalAssets.fisher.version | toJson }}
    set -l fisher_commit {{ .externalAssets.fisher.commit | toJson }}
    echo "Installing Fisher..."
    set -l checkout (mktemp -d)
    set -l verified 0
    if git clone --quiet --depth 1 --branch $fisher_version https://github.com/jorgebucaran/fisher.git $checkout
        and test (git -C $checkout rev-parse HEAD) = $fisher_commit
        set verified 1
    end
    if test $verified = 1
        source $checkout/functions/fisher.fish
        and fisher install jorgebucaran/fisher@$fisher_commit
    else
        echo "Fisher bootstrap failed verification; refusing to run unverified code." >&2
    end
    test -n "$checkout"; and command rm -rf -- $checkout
end

set -U __done_notification_urgency_level low
set -U __done_min_cmd_duration 10000
