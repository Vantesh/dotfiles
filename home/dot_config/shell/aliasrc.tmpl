#!/usr/bin/env bash

# --------------------------------------------------------------------
# COLOR-ENHANCED COMMANDS
# --------------------------------------------------------------------
alias diff="diff --color=auto"
alias dir="dir --color=auto"
alias vdir="vdir --color=auto"
alias ip="ip -color"

# --------------------------------------------------------------------
# GIT ALIASES
# --------------------------------------------------------------------
alias gs="git status --short --branch"
alias gl="git log --all --graph --pretty=format:'%C(magenta)%h %C(cyan)%an <%ae> %C(white)%ar%C(auto) %D%n%s%n'"
alias gcl="git clone"
alias gd="git diff"

# --------------------------------------------------------------------
# LESS DESTRUCTIVE ALIASES
# --------------------------------------------------------------------
alias rm="rm -i"
alias mv="mv -i"
alias cp="cp -i"
alias ln="ln -i"

# --------------------------------------------------------------------
# MODERN COMMAND REPLACEMENTS
# --------------------------------------------------------------------

[ -x "$(command -v eza)" ] && {
    alias ls="eza -a --icons=always --color=always --group-directories-first"
    alias ll="eza -al --icons=always --color=always --group-directories-first"
    alias la="eza -A --icons=always --color=always --group-directories-first"
    alias lt="eza -lT"
}

[ -x "$(command -v bat)" ] && {
    alias cat="bat"
    alias less="bat --paging=always"
    alias more="bat --paging=always"
}

[ -x "$(command -v duf)" ] && alias df="duf --output mountpoint,size,avail,type,filesystem"
[ -x "$(command -v dust)" ] && alias du="dust -r"
[ -x "$(command -v delta)" ] && alias diff="delta"

[ -x "$(command -v curlie)" ] && alias curl="curlie"

[ -x "$(command -v nvim)" ] && {
    alias vim="nvim"
    alias vi="nvim"
    alias vimdiff="nvim -d"
    alias view="nvim -R"
    alias v="nvim"
}

# --------------------------------------------------------------------
# UTILITY ALIASES
# --------------------------------------------------------------------
alias ping="ping -c 10"
alias wget='wget --hsts-file="$XDG_DATA_HOME/wget-hsts" -c'
alias adb='command mkdir -p "$XDG_DATA_HOME/android" && HOME="$XDG_DATA_HOME"/android adb'
{{ if lookPath "nvidia-settings" -}}
alias nvidia-settings='command mkdir -p "$XDG_CONFIG_HOME/nvidia" && nvidia-settings --config="$XDG_CONFIG_HOME"/nvidia/settings'
{{ end -}}
alias jtcl="journalctl -p 3 -xb"
alias h="history"
alias mkdir="mkdir -p"

{{- if eq .distroFamily "arch" }}

# --------------------------------------------------------------------
# PACKAGE MANAGEMENT (Arch Linux)
# --------------------------------------------------------------------
alias mirror='sudo reflector @/etc/xdg/reflector/reflector.conf'
alias cleanup='sudo pacman -Rns $(pacman -Qtdq)'
unalias fixpacman 2>/dev/null || true
fixpacman() {
    sudo -v || return 1
    local status=0
    command pgrep -x 'pacman|yay|paru|pamac|pamac-daemon|packagekitd' >/dev/null || status=$?
    case "$status" in
        0)
            echo "A package manager is running; refusing to remove the pacman lock." >&2
            return 1
            ;;
        1)
            sudo -n rm /var/lib/pacman/db.lck
            ;;
        *)
            echo "Could not check for active package transactions; refusing to remove the pacman lock." >&2
            return 1
            ;;
    esac
}
alias paruf="paru -Slq | tv --preview-command 'paru -Sii {}' --layout portrait --preview-size 75 | xargs -ro paru -S"


{{- end }}
