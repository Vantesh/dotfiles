# chezmoi:modify-template
{{- /* Repository preferences override listed fields; DMS retains other state. */ -}}
{{- $defaults := include ".chezmoitemplates/dms_settings.jsonc" | fromJsonc -}}
{{- $input := .chezmoi.stdin | trim -}}
{{- $current := dict -}}
{{- if $input -}}
  {{- $current = fromJson $input -}}
  {{- if not (kindIs "map" $current) -}}
    {{- fail "DMS settings.json must contain a JSON object" -}}
  {{- end -}}
{{- else -}}
  {{- $_ := set $current "configVersion" $defaults.configVersion -}}
{{- end -}}
{{- /* Seed the schema version only for a missing or empty settings file. */ -}}
{{- $preferences := omit $defaults "configVersion" -}}
{{ mergeOverwrite $current $preferences | toPrettyJson }}
