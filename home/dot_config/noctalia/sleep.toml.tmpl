{{- /* Idle service configuration. The Hibernate step is laptop-only and requires
provisioned hibernation: run_onchange_before_07_hibernation checks the chassis
and only owns the resume swapfile, leaving ~/.local/state/chezmoi/
hibernation.swapfile as its ownership record. Desktops keep suspend at
lock-and-suspend instead. */ -}}
{{- $state := env "XDG_STATE_HOME" -}}
{{- if not $state -}}{{- $state = joinPath .chezmoi.homeDir ".local/state" -}}{{- end -}}
{{- $hibernation := false -}}
{{- if .personal -}}
{{-   $owner := stat (joinPath $state "chezmoi/hibernation.swapfile") -}}
{{-   if $owner }}{{- $hibernation = true -}}{{- end -}}
{{- end -}}

[idle]
pre_action_fade_seconds = 5
behavior_order = [{{ if $hibernation }}"lock", "screen-off", "lock-and-suspend", "Hibernate"{{ else }}"lock", "screen-off", "lock-and-suspend"{{ end }}]

[idle.behavior.lock]
action = "lock"
enabled = true
timeout = 1200.0

[idle.behavior.screen-off]
action = "screen_off"
enabled = true
locked_timeout = 60.0
timeout = 1500.0

[idle.behavior.lock-and-suspend]
action = "lock_and_suspend"
{{- if $hibernation }}
enabled = false
{{- else }}
enabled = true
{{- end }}
timeout = 1800.0

[[shell.session.actions]]
action = "lock"
countdown_seconds = 0.0
enabled = true
shortcut = "1"
variant = "default"

[[shell.session.actions]]
action = "logout"
countdown_seconds = 0.0
enabled = true
shortcut = "2"
variant = "default"

[[shell.session.actions]]
action = "lock_and_suspend"
countdown_seconds = 0.0
enabled = true
shortcut = "3"
variant = "default"

[[shell.session.actions]]
action = "reboot"
countdown_seconds = 3.0
enabled = true
shortcut = "4"
variant = "default"

[[shell.session.actions]]
action = "shutdown"
countdown_seconds = 3.0
enabled = true
shortcut = "5"
variant = "destructive"

{{- if $hibernation }}

[idle.behavior.Hibernate]
action = "command"
command = "systemctl suspend-then-hibernate"
enabled = true
timeout = 1900.0

[[shell.session.actions]]
action = "command"
command = "systemctl hibernate"
countdown_seconds = 3.0
enabled = true
glyph = "hibernate"
label = "Hibernate"
shortcut = "6"
variant = "default"

{{- end }}
