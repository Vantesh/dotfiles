[theme]
community_palette = "Oxocarbon"
mode = "dark"
source = "wallpaper"
wallpaper_scheme = "m3-content"

[wallpaper]
transition = ["wipe"]
directory = "~/Pictures/Wallpapers"
fill_mode = "fit"

[wallpaper.automation]
enabled = true
interval_seconds = 86400

[shell]
font_family = {{ .font.ui.name | quote }}
