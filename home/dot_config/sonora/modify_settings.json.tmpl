#!/usr/bin/env python3
# Manage selected Sonora settings while preserving application-owned state.

import json
import sys
from typing import cast

MANAGED_SETTINGS = {
    "check_updates": False,
    "auto_update": False,
    "font": {{ .font.ui.name | toJson }},
    "close_to_tray": True,
    "cache_gb": 10,
    "gapless": True,
}

MANAGED_APPEARANCE = {
    "player_bar_layout": "classic",
    "player_bar_transparent": True,
    "player_bar_time_left": True,
    "icons": "lucide",
    "rounding": "subtle",
    "page_width": "wide",
    "blur": True,
    "blur_window": True,
    "font_size": 15.0,
    "transparent": False,
    "transparency": 0.0,
}


def main() -> int:
    original = sys.stdin.read()
    try:
        parsed = cast("object", json.loads(original if original.strip() else "{}"))
        if not isinstance(parsed, dict):
            raise ValueError("settings must be a JSON object")
        current = cast("dict[str, object]", parsed)
        changed = any(current.get(key) != value for key, value in MANAGED_SETTINGS.items())
        current.update(MANAGED_SETTINGS)

        appearance_value = current.get("appearance")
        if appearance_value is None:
            appearance: dict[str, object] = {}
            current["appearance"] = appearance
            changed = True
        elif isinstance(appearance_value, dict):
            appearance = cast("dict[str, object]", appearance_value)
        else:
            raise ValueError("appearance must be a JSON object")

        if any(appearance.get(key) != value for key, value in MANAGED_APPEARANCE.items()):
            changed = True
        appearance.update(MANAGED_APPEARANCE)
    except (ValueError, RecursionError) as error:
        print(f"Cannot update Sonora settings: {error}", file=sys.stderr)
        return 1

    if changed:
        _ = sys.stdout.write(json.dumps(current, indent=2, ensure_ascii=False) + "\n")
    else:
        _ = sys.stdout.write(original)
    return 0


if __name__ == "__main__":
    sys.exit(main())
