// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "edit_predictions": {
    "provider": "zed",
  },
  "status_bar": {
    "pending_keystrokes_indicator": true,
    "line_endings_button": true,
    "cursor_position_button": true,
  },
  "prettier": {
    "allowed": true,
  },
  "colorize_brackets": true,
  "inlay_hints": {
    "enabled": true,
  },
  "format_on_save": "on",
  "tab_size": 2,

  "relative_line_numbers": "disabled",
  "autosave": "on_focus_change",
  "cursor_shape": "bar",
  "cursor_animation": {
    "enabled": false,
  },
  "text_rendering_mode": "platform_default",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "collaboration_panel": {
    "button": false,
  },
  "outline_panel": {
    "button": false,
  },
  "agent": {
    "default_profile": "write",
    "default_width": 200.0,
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "buffer_font_features": {},
  "buffer_line_height": {
    "custom": 2,
  },

  "ui_font_fallbacks": [
    "JetBrainsMono Nerd Font Mono",
    "Adwaita Mono",
    "SF Mono",
  ],

  "icon_theme": "Material Icon Theme",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "vim_mode": false,
  "agent_servers": {
    "github-copilot-cli": {
      "default_config_options": {
        "mode": "https://agentclientprotocol.com/protocol/session-modes#autopilot",
      },
      "type": "registry",
    },
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "DankShell Light",
    "dark": "DankShell Dark",
  },

  "theme_overrides": {
    "DankShell Dark": {
      "border.variant": "#00000000",
      "border": "#00000000",
      "panel.focused_border": "#00000000",
      "pane.focused_border": "#00000000",

      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },
  "title_bar": {
    "show_branch_status_icon": false,
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_user_menu": false,
  },
  "tab_bar": {
    "show": false,
  },

  "project_panel": {
    "button": true,
    "indent_guides": {
      "show": "never",
    },
    "bold_folder_labels": false,
    "indent_size": 10.0,
    "git_status": true,
    "dock": "left",
    "auto_fold_dirs": false,
    "starts_open": false,
    "default_width": 250,
    "sticky_scroll": false,
    "hide_root": true,
    "scrollbar": {
      "show": "never",
    },
  },

  "file_finder": {
    "modal_max_width": "medium",
  },

  "scrollbar": {
    // When to show the scrollbar in the editor (auto, system, always, never)
    "show": "auto",
    "cursors": true, // Show cursor positions in the scrollbar.
    "git_diff": true, // Show git diff indicators in the scrollbar.
    "search_results": true, // Show buffer search results in the scrollbar.
    "selected_text": true, // Show selected text occurrences in the scrollbar.
    "selected_symbol": true, // Show selected symbol occurrences in the scrollbar.
    "diagnostics": "all", // Show diagnostics (none, error, warning, information, all)
    "axes": {
      "horizontal": false, // Show/hide the horizontal scrollbar
      "vertical": false, // Show/hide the vertical scrollbar
    },
  },

  // Minimap related settings
  "minimap": {
    "show": "auto", // When to show (auto, always, never)
    "display_in": "active_editor", // Where to show (active_editor, all_editors)
    "thumb": "hover", // When to show thumb (always, hover)
    "thumb_border": "none", // Thumb border (left_open, right_open, full, none)
    "max_width_columns": 50, // Maximum width of minimap
    "current_line_highlight": null, // Highlight current line (null, line, gutter)
  },

  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false,
  },
  "drag_and_drop_selection": {
    "enabled": false,
  },

  "selection_highlight": false,
  "seed_search_query_from_cursor": "never",
  "current_line_highlight": "none",
  "show_whitespaces": "none",
  "agent_buffer_font_size": 14,

  "file_types": {
    "JSONC": ["*.json", "tsconfig*.json"],
    "Plain Text": ["modify_settings.json"],
  },

  // Maximum number of tabs per pane. Unset for unlimited.
  "max_tabs": null,

  "tabs": {
    "git_status": true, // Color to show git status
    "close_position": "right", // Close button position (left, right, hidden)
    "show_close_button": "hover", // Close button shown (hover, always, hidden)
    "file_icons": true, // Icon showing file type
    // Show diagnostics in file icon (off, errors, all). Requires file_icons=true
    "show_diagnostics": "errors",
  },

  "lsp": {
    "lua-language-server": {
      "settings": {
        "Lua": {
          "workspace": {
            "library": ["/usr/share/hypr/stubs"],
          },
        },
      },
    },
  },
}
