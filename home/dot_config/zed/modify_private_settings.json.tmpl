#!/usr/bin/env python3
# Enforce baseline settings without capturing Zed-owned settings in source state.

import json
import re
import sys
from typing import cast

STRING_OR_COMMENT = re.compile(r'"(?:\\.|[^"\\])*"|//[^\r\n]*|/\*[\s\S]*?\*/')
STRING_OR_TRAILING_COMMA = re.compile(r'"(?:\\.|[^"\\])*"|,(\s*[}\]])')
# Keep the generated JSON string intact.
BASELINE = {{ include ".chezmoitemplates/zed-settings.jsonc" | toJson }}  # fmt: skip
FONT_SETTINGS: dict[str, object] = {
    "markdown_preview": {
        "code_font_family": {{ .font.monospace.name | toJson }},
    },
    "ui_font_family": {{ .font.ui.name | toJson }},
    "buffer_font_size": {{ .font.editor.size }},
    "buffer_font_family": {{ .font.monospace.name | toJson }},
    "buffer_font_features": {
        {{- range .font.monospace.features }}
        {{ . | toJson }}: True,
        {{- end }}
    },
}


def parse_jsonc(text: str) -> dict[str, object]:
    """Parse JSON with comments and trailing commas, preserving string contents."""
    text = STRING_OR_COMMENT.sub(lambda match: match[0] if match[0].startswith('"') else " ", text)
    text = STRING_OR_TRAILING_COMMA.sub(
        lambda match: match[1] if match[1] is not None else match[0], text
    )
    value = cast("object", json.loads(text))
    if not isinstance(value, dict):
        raise ValueError("settings must be a JSON object")
    return cast("dict[str, object]", value)


def apply_baseline(current: dict[str, object], baseline: dict[str, object]) -> None:
    """Override managed leaves while retaining unlisted keys at every level."""
    for key, value in baseline.items():
        if isinstance(value, dict):
            if not isinstance(current.get(key), dict):
                current[key] = {}
            apply_baseline(
                cast("dict[str, object]", current[key]), cast("dict[str, object]", value)
            )
        else:
            current[key] = value


def main() -> int:
    original = sys.stdin.read()
    try:
        baseline = parse_jsonc(BASELINE)
        apply_baseline(baseline, FONT_SETTINGS)
        current = parse_jsonc(original) if original.strip() else {}
        before = json.dumps(current, sort_keys=True)
        apply_baseline(current, baseline)
    except (ValueError, RecursionError) as error:
        print(f"Cannot update Zed settings: {error}", file=sys.stderr)
        return 1

    if json.dumps(current, sort_keys=True) == before:
        _ = sys.stdout.write(original)
    else:
        _ = sys.stdout.write(json.dumps(current, indent=2, ensure_ascii=False) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
