{{- $personal := get . "personal" | default false -}}
{{- $keyCommand := has .chezmoi.command (list "apply" "init" "update") -}}
{{- $debug := regexMatch "(^| )--debug(=| |$)" (join " " .chezmoi.args) -}}
{{- $preview := or .chezmoi.flags.dryRun .chezmoi.config.verbose $debug (not $keyCommand) -}}
{{- $importKeys := and $personal (not $preview) -}}
{{- $nvidiaSettings := lookPath "nvidia-settings" -}}

# Personal configuration
{{ if not $personal -}}
.ssh
.config/{git,atuin}
.config/fish/conf.d/atuin.fish
{{ end -}}

# Import only the managed SSH keys, never during previews or verbose/debug output.
.ssh/{id_*,*.pem,known_hosts*}
{{ if $importKeys -}}
!.ssh/{id_rsa,id_rsa.pub}
{{ end -}}

# Runtime state and placeholder files
.config/fish/fish_variables
.config/{codex,copilot}/*
.config/nvim/lazy-lock.json
.config/systemd/user/*.wants

# Generated themes and installed Yazi packages
.config/**/themes/**
.config/gtk-{3,4}.0/noctalia.css
.config/yazi/{plugins,flavors}/**


# Optional NVIDIA configuration
{{ if not $nvidiaSettings -}}
.config/fish/functions/nvidia-settings.fish
.local/share/applications/nvidia-settings.desktop
{{ end -}}
