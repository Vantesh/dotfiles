# Secrets & temp files
key.txt.age
tmp*
.bitwarden-ssh-agent.sock
.netrc
.password-store
.ssh/{id_*,*.pem,authorized_keys,known_hosts*}
!.ssh/*.pub
.gnupg/{private-keys-v1.d,openpgp-revocs.d,pubring.kbx*,trustdb.gpg,random_seed,S.*,*.lock}
.aws
.azure
.kube/{cache,config}
.docker/config.json
.config/gh/hosts.yml

# Backup, swap & junk files
**/*.{bak,backup,bkp,old,orig,ori,rej,swp,swo,tmp,temp,log,zwc,pacnew,pacsave,pacorig,save,sav}
**/*.{bak,backup,bkp,old,orig}*
**/*~
**/*.~*~
**/{.backup,.backups,backups,Backups}
**/*.sock
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/__pycache__
**/*.pyc
**/node_modules

# Shell & tool history/state
.bash_history
.zsh_history
.python_history
.node_repl_history
.lesshst
.viminfo
.wget-hsts
.sudo_as_admin_successful
.xsession-errors*
.Xauthority
.ICEauthority
.config/zsh/.{history,zcompdump}
.config/fish/fish_variables

# IDE & cache
.vscode
.{cache,pki,m2,nv,dotnet,thumbnails,java}

# Dev toolchains & package manager data
.{npm,pnpm-store,nvm,bun,deno,gradle,android,gem,pyenv,rustup,conda,steam,wine,mozilla}
.cargo/{registry,git,bin}

# App state/cache
.config/{BraveSoftware/*,google-chrome/*,Authy*,Bitwarden*,fcitx5/conf/cached_layouts,lazygit/state.yml,rbw,wakatime}
!.config/google-chrome/NativeMessagingHosts/**
!.config/BraveSoftware/NativeMessagingHosts/**
.config/{pulse,dconf,goa-1.0,session,Trolltech.conf}
.config/Code/{Cache*,CachedData,GPUCache,logs,Crashpad,Backups,User/{workspaceStorage,globalStorage,History}}
.config/**/{cache,Cache,GPUCache,CachedData,Crashpad,blob_storage,IndexedDB,Service Worker,Session Storage,Local Storage,Code Cache,logs,crash_reports}
.config/clipse/{clipboard_history.json,tmp_files}
.config/{codex,copilot}/*
.config/nvim/lazy-lock.json
.config/systemd/user/*.wants

# User directories
{Downloads,Documents,Desktop,Music,Videos,Public,Templates,Pictures}

# .local (whitelist only what's needed)
.local/*
!.local/share/{icons,fonts,themes}
!.local/bin

# Generated theme files
.config/**/{themes,Themes}/**
**/theme.toml*
.config/{qt5ct,qt6ct}
.config/gtk-{3,4}.0/{colors.css,assets}
.config/gtk-4.0/bookmarks
.config/nvim/colors/noctalia.lua
.config/kitty/{color*,current-theme.conf}
.config/nvim/colors

# Yazi plugins/flavors
.config/yazi/{plugins,flavors}/**

# Platform-specific
{{ if ne .chezmoi.os "linux" -}}
.chezmoiscripts/linux/**
.config/{kitty,hypr,rofi,matugen,kvantum,paru,clipse,gtk*,uwsm}
{{ end -}}
{{ if ne .chezmoi.os "windows" -}}
.chezmoiscripts/windows/**
{{ end -}}
{{ if eq .chezmoi.os "windows" -}}
!Documents/*PowerShell/
{{ end }}

# Conditional tools
{{ if not (lookPath "hypridle") -}}
.config/hypr/hypridle.conf
{{ end -}}
{{ if not (lookPath "hyprlock") -}}
.config/hypr/hyprlock.conf
{{ end }}

# Shell-specific
{{ if ne .defaultShell "zsh" -}}
.config/{zsh,fsh}
{{ end -}}
{{ if ne .defaultShell "fish" -}}
.config/fish
{{ end }}

# personal files
{{- if not .personal }}
.config/atuin
.config/fish/conf.d/atuin.fish
.config/git
{{- end }}
