{{ if not (env "OFFLINE") }}
{{- if eq .chezmoi.os "linux" }}

{{- $refresh := "744h" }}
{{- $hypr := "Vantesh/mactahoe-hyprcursor" }}

# MacTahoe icon-theme cursors are installed with the icon themes themselves.
".local/share/icons/MacTahoe-hyprcursor":
  url: {{ gitHubLatestReleaseAssetURL $hypr "MacTahoe-hyprcursor.tar.gz" | quote }}
  type: archive
  stripComponents: 1
  refreshPeriod: {{ $refresh | quote }}

".local/share/icons/MacTahoe-dark-hyprcursor":
  url: {{ gitHubLatestReleaseAssetURL $hypr "MacTahoe-dark-hyprcursor.tar.gz" | quote }}
  type: archive
  stripComponents: 1
  refreshPeriod: {{ $refresh | quote }}

{{- end }}
{{ end }}
