{{ if not (env "OFFLINE") }}
{{- if eq .chezmoi.os "linux" }}

{{- $hypr := .externalAssets }}

# MacTahoe icon-theme cursors are installed with the icon themes themselves.
".local/share/icons/MacTahoe-hyprcursor":
  url: "https://github.com/Vantesh/mactahoe-hyprcursor/releases/download/{{ $hypr.macTahoeHyprcursorLight.version }}/MacTahoe-hyprcursor.tar.gz"
  type: archive
  stripComponents: 1
  checksum:
    sha256: {{ $hypr.macTahoeHyprcursorLight.sha256 | quote }}

".local/share/icons/MacTahoe-dark-hyprcursor":
  url: "https://github.com/Vantesh/mactahoe-hyprcursor/releases/download/{{ $hypr.macTahoeHyprcursorDark.version }}/MacTahoe-dark-hyprcursor.tar.gz"
  type: archive
  stripComponents: 1
  checksum:
    sha256: {{ $hypr.macTahoeHyprcursorDark.sha256 | quote }}

{{- end }}
{{ end }}
