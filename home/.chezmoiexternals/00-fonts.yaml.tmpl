{{- if and (eq .chezmoi.os "linux") (not (env "OFFLINE")) -}}
{{- $fontDir := ".local/share/fonts" -}}
{{- $refresh := "336h" -}}

{{/* Apple Color Emoji for Linux */}}
"{{ $fontDir }}/emojis/AppleColorEmoji.ttf":
  type: file
  url: {{ gitHubLatestReleaseAssetURL "samuelngs/apple-emoji-ttf" "AppleColorEmoji-Linux.ttf" | quote }}
  refreshPeriod: {{ $refresh | quote }}

{{/* Maple Mono Nerd Font */}}
"{{ $fontDir }}/MapleMono":
  type: archive
  url: {{ gitHubLatestReleaseAssetURL "subframe7536/maple-font" "MapleMono-NF-unhinted.zip" | quote }}
  refreshPeriod: {{ $refresh | quote }}
  include:
    - "*.ttf"

{{- end -}}
