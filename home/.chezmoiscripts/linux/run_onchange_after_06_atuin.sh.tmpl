#!/usr/bin/env bash
# 06_atuin.sh - Configure Atuin shell history sync
# Exit codes: 0 (success), 1 (failure)

{{- if .personal }}

set -euo pipefail

shopt -s nullglob globstar

readonly LIB_DIR="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/.chezmoiscripts/linux/lib"

# shellcheck source=/dev/null
source "$LIB_DIR/.lib-common.sh"
# shellcheck source=/dev/null
source "$LIB_DIR/.lib-package_manager.sh"

# Logs in with runtime vault credentials and synchronizes history.
# Captures fields with a sentinel, removing only rbw's final output newline.
# Globals: LAST_ERROR - Set on failure.
# Outputs: Result and error logs to stderr; Atuin sync output.
# Returns: 0 on success, 1 on failure, 127 on missing dependency.
login_atuin() {
  local username password key
  LAST_ERROR=""

  if ! command_exists atuin; then
    LAST_ERROR="atuin command not found"
    return 127
  fi

  if atuin status >/dev/null 2>&1; then
    log SKIP "Atuin already logged in"
    return 0
  fi

  if ! command_exists rbw; then
    LAST_ERROR="rbw command not found"
    return 127
  fi

  if ! username="$(rbw get --field username Atuin && printf '.')" ||
    ! password="$(rbw get --field password Atuin && printf '.')" ||
    ! key="$(rbw get --field atuin_key Atuin && printf '.')"; then
    LAST_ERROR="Failed to retrieve Atuin credentials from Bitwarden"
    return 1
  fi

  username="${username%.}"
  username="${username%$'\n'}"
  password="${password%.}"
  password="${password%$'\n'}"
  key="${key%.}"
  key="${key%$'\n'}"

  if ! atuin login \
    --username "$username" \
    --password "$password" \
    --key "$key" >/dev/null 2>&1; then
    LAST_ERROR="Failed to login to Atuin"
    return 1
  fi

  if ! atuin sync; then
    LAST_ERROR="Failed to sync Atuin history"
    return 1
  fi

  log INFO "Logged in to Atuin and synced history"
  return 0
}

main() {

  print_box "Atuin"
  log STEP "Atuin Configuration"

  if ! install_package "atuin"; then
    die "Failed to install atuin: $LAST_ERROR"
  fi


  if login_atuin; then
    :
  else
    local exit_code="$?"
    die "$exit_code" "Failed to login to Atuin: $LAST_ERROR"
  fi

  log INFO "Atuin configuration complete"
}

main "$@"

{{- end }}
