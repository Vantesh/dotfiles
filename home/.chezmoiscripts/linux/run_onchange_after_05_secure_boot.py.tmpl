#!/usr/bin/python3 -B
# profile: {{ .personal | toJson }}
# source-dir: {{ if .personal }}{{ .chezmoi.sourceDir | toJson }}{{ else }}disabled{{ end }}
# limine_config.py: {{ if .personal }}{{ include ".chezmoitemplates/lib/limine_config.py" | sha256sum }}{{ else }}disabled{{ end }}
# secure_boot.py: {{ if .personal }}{{ include ".chezmoitemplates/lib/secure_boot.py" | sha256sum }}{{ else }}disabled{{ end }}
# hibernation_policy.py: {{ if .personal }}{{ include ".chezmoitemplates/lib/hibernation_policy.py" | sha256sum }}{{ else }}disabled{{ end }}
"""Configure sbctl and Limine verification without enabling firmware Secure Boot."""

import json
import os
import shutil
import signal
import subprocess
import sys
import traceback
from pathlib import Path
from typing import cast

from loguru import logger

LIMINE = Path("/usr/bin/limine")
EFIVARS = Path("/sys/firmware/efi/efivars")


def terminate(_signum: int, _frame: object) -> None:
    raise SystemExit(143)


def main() -> int:
    privileged = sys.argv[1:2] == ["--configure"]
    if privileged and len(sys.argv) != 6:
        print(
            "ERROR: Boot setup requires its state directory, source directory and profile.",
            file=sys.stderr,
        )
        return 1
    personal = sys.argv[4] if privileged else os.environ.get("DOTFILES_PERSONAL_ENABLED")
    if personal == "0":
        return 0
    if personal != "1":
        print(
            "ERROR: DOTFILES_PERSONAL_ENABLED must be '0' or '1'; run through Chezmoi.",
            file=sys.stderr,
        )
        return 1
    source_dir = Path(sys.argv[3]) if privileged else Path(os.environ["CHEZMOI_SOURCE_DIR"])
    if not source_dir.is_absolute():
        print("ERROR: Chezmoi must supply an absolute source directory.", file=sys.stderr)
        return 1
    sys.path.insert(0, str(source_dir / ".chezmoitemplates"))
    _ = signal.signal(signal.SIGTERM, terminate)
    from lib.secure_boot import configure_secure_boot

    if privileged:
        try:
            state = Path(sys.argv[2])
            if os.geteuid() != 0 or not state.is_absolute():
                raise ValueError(
                    "Privileged boot setup requires root and an absolute state directory."
                )
            if sys.argv[5] not in ("enroll", "reuse"):
                raise ValueError("Invalid Secure Boot consent argument.")
            configure_secure_boot(state, enroll=sys.argv[5] == "enroll")
            return 0
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            traceback.print_exc()
            return error.returncode if isinstance(error, subprocess.CalledProcessError) else 1
    from lib.provision_logging import configure_logging

    file_sink = None
    try:
        file_sink = configure_logging()
        if sys.argv[1:] or os.geteuid() == 0:
            raise ValueError("Run boot provisioning as the regular account without arguments.")
        if not os.access(LIMINE, os.X_OK):
            return 0
        if "arch" not in os.environ["DOTFILES_DISTRO_FAMILY"].lower() or not EFIVARS.is_dir():
            return 0
        if shutil.which("mkinitcpio") is None:
            raise FileNotFoundError("mkinitcpio not found; complete the Limine installation.")
        _ = subprocess.run(["sudo", "-v"], check=True)
        inspected = subprocess.run(
            ["sudo", "-n", "sbctl", "--json", "status"], check=True, capture_output=True, text=True
        )
        # Read status without giving the regular process access to key material.
        status = cast("dict[str, object]", json.loads(inspected.stdout))
        if any(
            type(status.get(key)) is not bool for key in ("installed", "setup_mode", "secure_boot")
        ):
            raise ValueError("Unexpected sbctl status.")
        consent = "reuse"
        if status["setup_mode"]:
            if os.environ.get("NOCONFIRM") == "1" or any(
                os.environ.get(name) for name in ("CI", "GITHUB_ACTIONS", "GITLAB_CI", "CODESPACES")
            ):
                raise ValueError(
                    "First-time Secure Boot enrollment needs explicit consent; reapply interactively in Setup Mode."
                )
            with Path("/dev/tty").open("r+") as terminal:
                _ = terminal.write(
                    "Enroll local Secure Boot keys and Microsoft certificates in firmware? This replaces the key databases. [y/N] "
                )
                terminal.flush()
                if terminal.readline().strip().lower() not in ("y", "yes"):
                    raise ValueError(
                        "Secure Boot enrollment declined; keys were preserved. Reapply when ready."
                    )
            consent = "enroll"
        state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "chezmoi"
        result = subprocess.run(
            [
                "sudo",
                "-n",
                sys.executable,
                "-B",
                str(Path(__file__).resolve()),
                "--configure",
                str(state),
                str(source_dir),
                personal,
                consent,
            ],
            check=True,
            capture_output=consent != "enroll",
            text=True,
        )
        for message in (result.stdout or "").splitlines():
            logger.info(message)
        return 0
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        status = error.returncode if isinstance(error, subprocess.CalledProcessError) else 1
        try:
            logger.opt(exception=True).error("Boot setup failed (exit {}): {}", status, error)
            if isinstance(error, subprocess.CalledProcessError):
                diagnostic = cast("str | None", error.stderr)
                if diagnostic:
                    logger.debug("System diagnostic:\n{}", diagnostic.rstrip())
        except OSError:
            if file_sink is not None:
                logger.remove(file_sink)
        return status
    except KeyboardInterrupt:
        logger.warning("Boot setup interrupted; reapply when ready.")
        return 130


if __name__ == "__main__":
    status = main()
    sys.exit(status if status >= 0 else 128 - status)
