#!/usr/bin/env bash
# 10_atuin.sh - Configure Atuin shell history sync
# Exit codes: 0 (success), 1 (failure)

{{- if .personal }}

# distro-family: {{ .distroFamily | quote }}
# Atuin config: {{ include "dot_config/private_atuin/private_config.toml" | sha256sum }}
# XDG config home: {{ env "XDG_CONFIG_HOME" | default (joinPath .chezmoi.homeDir ".config") | toJson }}


set -euo pipefail

shopt -s nullglob globstar

# This setup hook runs before a new login session loads Fish or environment.d.
export ATUIN_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/atuin"
export ATUIN_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/atuin"
export ATUIN_LOGS__DIR="${XDG_STATE_HOME:-$HOME/.local/state}/atuin"
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  export ATUIN_DAEMON__SOCKET_PATH="$XDG_RUNTIME_DIR/atuin.sock"
  export ATUIN_DAEMON__PIDFILE_PATH="$XDG_RUNTIME_DIR/atuin.pid"
fi

{{ include ".chezmoitemplates/lib/common.sh" }}

# Chezmoi's dot_config source has a fixed target. Publish the same managed
# configuration at an explicitly selected XDG root before Atuin creates defaults.
if [[ "$ATUIN_HOME" != "$HOME/.config/atuin" ]]; then
  install -d -m 700 -- "$ATUIN_HOME"
  install -D -C -m 600 -- \
    "$CHEZMOI_SOURCE_DIR/dot_config/private_atuin/private_config.toml" \
    "$ATUIN_HOME/config.toml"
fi

# Logs in with runtime vault credentials and synchronizes history.
# Captures fields with a sentinel, removing only rbw's final output newline.
# Globals: LAST_ERROR - Set on failure.
# Outputs: Result and error logs to stderr; Atuin sync output.
# Returns: 0 on success, 1 on failure, 127 on missing dependency.
login_atuin() {
  local username password key
  LAST_ERROR=""

  if ! command_exists atuin; then
    LAST_ERROR="atuin command not found"
    return 127
  fi

  if atuin status >/dev/null 2>&1; then
    log SKIP "Atuin already logged in"
    return 0
  fi

  if ! username="$(rbw get --field username Atuin && printf '.')" ||
    ! password="$(rbw get --field password Atuin && printf '.')" ||
    ! key="$(rbw get --field atuin_key Atuin && printf '.')"; then
    LAST_ERROR="Failed to retrieve Atuin credentials from Bitwarden"
    return 1
  fi

  username="${username%.}"
  username="${username%$'\n'}"
  password="${password%.}"
  password="${password%$'\n'}"
  key="${key%.}"
  key="${key%$'\n'}"

  if ! atuin login \
    --username "$username" \
    --password "$password" \
    --key "$key" >/dev/null 2>&1; then
    LAST_ERROR="Failed to login to Atuin"
    return 1
  fi

  if ! atuin sync; then
    LAST_ERROR="Failed to sync Atuin history"
    return 1
  fi

  log INFO "Logged in to Atuin and synced history"
  return 0
}

main() {
  log STEP "Atuin Configuration"

  if login_atuin; then
    :
  else
    local exit_code="$?"
    die "$exit_code" "Failed to login to Atuin: $LAST_ERROR"
  fi

  log INFO "Atuin configuration complete"
}

main "$@"

{{- end }}
