#!/usr/bin/env bash
# Application preferences are independent of the desktop theme and UI font.
set -euo pipefail

if ! command -v gsettings >/dev/null 2>&1; then
  printf 'gsettings not available; skipping Nautilus preferences\n' >&2
  exit 0
fi

zoom_level=$(gsettings get org.gnome.nautilus.icon-view default-zoom-level)
if [[ "$zoom_level" != "'small-plus'" ]]; then
  gsettings set org.gnome.nautilus.icon-view default-zoom-level "small-plus"
fi
show_delete=$(gsettings get org.gnome.nautilus.preferences show-delete-permanently)
if [[ "$show_delete" != true ]]; then
  gsettings set org.gnome.nautilus.preferences show-delete-permanently true
fi
