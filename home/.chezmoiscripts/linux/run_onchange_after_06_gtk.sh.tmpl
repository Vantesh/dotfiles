#!/usr/bin/env bash
{{ if .personal -}}
# Noctalia owns the user's theme; mirror its current settings for root.
set -euo pipefail

if ! command -v gsettings >/dev/null 2>&1; then
  printf 'gsettings not available; skipping GTK preferences\n' >&2
  exit 0
fi

# Keep failures nonzero so chezmoi retries rather than recording success.
gsettings set org.gnome.desktop.interface font-name {{ cat .font.ui.name .font.ui.size | shellQuote }}
gsettings set org.gnome.desktop.wm.preferences button-layout ":"

gtk_theme=$(gsettings get org.gnome.desktop.interface gtk-theme)
color_scheme=$(gsettings get org.gnome.desktop.interface color-scheme)
prefer_dark=false
if [[ "$color_scheme" == "'prefer-dark'" ]]; then
  prefer_dark=true
fi

# CSS supplies colors, but GTK also needs a base theme and dark preference.
for version in 3 4; do
  sudo install -d -m 755 "/root/.config/gtk-$version.0"
  for css in gtk.css noctalia.css; do
    sudo ln -sfnT "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-$version.0/$css" \
      "/root/.config/gtk-$version.0/$css"
  done
  {
    printf '[Settings]\ngtk-application-prefer-dark-theme=%s\n' "$prefer_dark"
    if [[ "$version" == 3 ]]; then
      theme_name=${gtk_theme#\'}
      printf 'gtk-theme-name=%s\n' "${theme_name%\'}"
    fi
  } | sudo tee "/root/.config/gtk-$version.0/settings.ini" >/dev/null
done

{{ end -}}
