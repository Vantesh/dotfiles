#!/usr/bin/env bash
# 02_tpm.sh - Configure signed initrd PCR policies for systemd NvPCRs
#
# Creates a minimal ukify configuration and machine-local PCR signing keys
# when absent, requesting a deferred initramfs rebuild before each creation.
# Existing configurations and keys are preserved; existing configurations
# must enable SignInitrdPCRs and configure a PCR signing private key.
# Default keys are managed only when
# referenced by the configuration.
# A late always-run after script handles rebuilding and retries using a
# persistent pending marker.
#
# Globals:
#   DISTRO_FAMILY - Distribution family from chezmoi scriptEnv
#   LAST_ERROR - Error message from the last failed operation
# Exit codes:
#   0 (success), 1 (failure), 127 (missing dependency)

set -euo pipefail

shopt -s nullglob globstar
#shellcheck disable=SC1083,SC1054
{{ include ".chezmoitemplates/lib/common.sh" }}
#shellcheck disable=SC1083,SC1073,SC1009
{{ include ".chezmoitemplates/lib/snapboot.sh" }}

readonly UKI_CONFIG="/etc/kernel/uki.conf"
readonly PCR_PRIVATE_KEY="/etc/systemd/tpm2-pcr-private-key.pem"
readonly PCR_PUBLIC_KEY="/etc/systemd/tpm2-pcr-public-key.pem"

main() {
  if [[ ! -x /usr/bin/limine ]]; then
    log WARN "Unsupported bootloader (only Limine is supported), skipping TPM PCR policy setup"
    return 0
  fi

  if ! command_exists mkinitcpio; then
    log WARN "mkinitcpio not found, skipping TPM PCR policy setup"
    return 0
  fi

  case "${DISTRO_FAMILY,,}" in
  *arch*) ;;
  *)
    log SKIP "TPM PCR policy setup is only configured for Arch Linux"
    return 0
    ;;
  esac

  if [[ ! -e /dev/tpmrm0 ]] && [[ ! -e /dev/tpm0 ]]; then
    log SKIP "TPM device not available"
    return 0
  fi

  if ! command_exists ukify; then
    die 127 "ukify command not found"
  fi

  if ! keep_sudo_alive; then
    die "Failed to obtain sudo access: $LAST_ERROR"
  fi

  if sudo test -e "$UKI_CONFIG"; then
    if ! sudo grep -qE '^[[:space:]]*SignInitrdPCRs[[:space:]]*=[[:space:]]*(yes|true|1)[[:space:]]*$' "$UKI_CONFIG"; then
      die "Existing $UKI_CONFIG preserved; enable SignInitrdPCRs=yes in [UKI] and configure PCR signing keys before retrying"
    fi
    if ! sudo grep -qE '^[[:space:]]*PCRPrivateKey[[:space:]]*=[[:space:]]*[^[:space:]]' "$UKI_CONFIG"; then
      die "Existing $UKI_CONFIG preserved; configure PCRPrivateKey before retrying"
    fi
    log SKIP "Preserved existing ukify configuration"
  else
    if ! request_initramfs_rebuild; then
      die "Failed to request initramfs rebuild: $LAST_ERROR"
    fi
    if ! write_system_config "$UKI_CONFIG" <<EOF
[UKI]
SignInitrdPCRs=yes

[PCRSignature:all]
PCRPrivateKey=$PCR_PRIVATE_KEY
PCRPublicKey=$PCR_PUBLIC_KEY
EOF
    then
      die "Failed to configure ukify: $LAST_ERROR"
    fi
    log INFO "Created ukify configuration"
  fi

  if sudo grep -qE \
    '^[[:space:]]*PCR(Private|Public)Key[[:space:]]*=[[:space:]]*/etc/systemd/tpm2-pcr-(private|public)-key\.pem[[:space:]]*$' \
    "$UKI_CONFIG"; then
    if sudo test -e "$PCR_PRIVATE_KEY" && sudo test -e "$PCR_PUBLIC_KEY"; then
      log SKIP "PCR signing keypair already exists"
    elif sudo test -e "$PCR_PRIVATE_KEY" || sudo test -e "$PCR_PUBLIC_KEY"; then
      die "Incomplete PCR signing keypair in /etc/systemd; existing key preserved"
    else
      if ! request_initramfs_rebuild; then
        die "Failed to request initramfs rebuild: $LAST_ERROR"
      fi
      if ! sudo ukify --config=/dev/null genkey \
        --pcr-private-key="$PCR_PRIVATE_KEY" \
        --pcr-public-key="$PCR_PUBLIC_KEY"; then
        die "Failed to generate PCR signing keypair"
      fi
      log INFO "Created PCR signing keypair"
    fi

    if ! sudo chmod 0600 "$PCR_PRIVATE_KEY" || ! sudo chmod 0644 "$PCR_PUBLIC_KEY"; then
      die "Failed to secure PCR signing key permissions"
    fi
  else
    log SKIP "Existing configuration uses its own PCR signing keys"
  fi
}

main "$@"
