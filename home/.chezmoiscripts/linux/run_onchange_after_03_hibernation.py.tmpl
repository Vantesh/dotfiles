from dataclasses import dataclass
from enum import IntEnum
from pathlib import Path
from typing import cast

from loguru import logger

ETC = Path("/etc")
DEV = Path("/dev")
SYS = Path("/sys")
PROC = Path("/proc")
SHARE = Path("/usr/share")
LIMINE = Path("/usr/bin/limine")
SWAP_MOUNT = Path("/swap")
SWAP_FILE = SWAP_MOUNT / "swapfile"


class ManualSetup(ValueError):
    """A verified unsupported layout must remain independently managed."""


class SetupResult(IntEnum):
    CONFIGURED = 0
    DEFERRED = 2
    MANUAL = 3


@dataclass(frozen=True)
class BtrfsDevice:
    device: Path
    uuid: str
    device_id: str
    luks_uuid: str = ""


def inspect_btrfs_device(target: Path) -> BtrfsDevice:
    result = subprocess.run(
        [
            "findmnt",
            "--nofsroot",
            "-rn",
            "-o",
            "TARGET,SOURCE,FSTYPE,UUID",
            "--target",
            str(target),
        ],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.splitlines()
    if len(result) != 1 or len(fields := result[0].split()) != 4:
        raise ValueError(f"Cannot inspect an unambiguous filesystem at {target}.")
    mount, source, filesystem, uuid = fields
    if not mount.startswith("/") or (target == Path("/") and mount != "/"):
        raise ValueError("Incorrect root mount identity; refusing swap provisioning.")
    if filesystem != "btrfs" or not re.fullmatch(
        r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", uuid
    ):
        raise ValueError(f"Invalid Btrfs filesystem identity at {target}.")
    device = Path(source).resolve(strict=True)
    block = subprocess.run(
        ["lsblk", "-dnro", "FSTYPE,UUID,MAJ:MIN", str(device)],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.split()
    if (
        len(block) != 3
        or block[:2] != ["btrfs", uuid]
        or not re.fullmatch(r"[0-9]+:[0-9]+", block[2])
    ):
        raise ValueError(f"Filesystem and backing block-device identity differ at {target}.")
    device_id = block[2]
    resolved = (DEV / "disk/by-uuid" / uuid).resolve(strict=True)
    if (
        subprocess.run(
            ["lsblk", "-dnro", "MAJ:MIN", str(resolved)], check=True, capture_output=True, text=True
        ).stdout.strip()
        != device_id
    ):
        raise ValueError("Filesystem UUID resolves to a different block device.")
    members = subprocess.run(
        ["btrfs", "filesystem", "show", "--raw", mount], check=True, capture_output=True, text=True
    ).stdout
    count = re.findall(r"Total devices\s+(\d+)", members)
    paths = cast("list[str]", re.findall(r"(?m)^\s*devid\s+\d+.*?\s+path\s+(.+)$", members))
    if count != ["1"] or len(paths) != 1:
        raise ManualSetup("Hibernation requires exactly one verified Btrfs device.")
    member = Path(paths[0]).resolve(strict=True)
    if (
        subprocess.run(
            ["lsblk", "-dnro", "MAJ:MIN", str(member)], check=True, capture_output=True, text=True
        ).stdout.strip()
        != device_id
    ):
        raise ValueError("Btrfs member differs from the backing block device.")
    topology = subprocess.run(
        ["lsblk", "-srn", "-o", "TYPE", str(device)], check=True, capture_output=True, text=True
    ).stdout.splitlines()
    if topology in (["disk"], ["part", "disk"]):
        return BtrfsDevice(device, uuid, device_id)
    if topology not in (["crypt", "disk"], ["crypt", "part", "disk"]):
        raise ManualSetup("Unsupported block-device topology; configure hibernation manually.")
    slaves = list((SYS / "dev/block" / device_id / "slaves").glob("*"))
    if len(slaves) != 1:
        raise ValueError("LUKS mapping requires one direct backing device.")
    parent_id = (slaves[0] / "dev").read_text().strip()
    if not re.fullmatch(r"[0-9]+:[0-9]+", parent_id) or parent_id == device_id:
        raise ValueError("Invalid LUKS backing-device identity.")
    parent = (DEV / "block" / parent_id).resolve(strict=True)
    if (
        subprocess.run(
            ["lsblk", "-dnro", "MAJ:MIN", str(parent)], check=True, capture_output=True, text=True
        ).stdout.strip()
        != parent_id
    ):
        raise ValueError("LUKS backing-device alias differs.")
    kind = subprocess.run(
        ["blkid", "-p", "-s", "TYPE", "-o", "value", str(parent)],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    status = subprocess.run(
        ["env", "LC_ALL=C", "cryptsetup", "status", str(device)],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    types = re.findall(r"(?m)^\s*type:\s*(\S+)\s*$", status)
    backing = cast("list[str]", re.findall(r"(?m)^\s*device:\s*(.+)$", status))
    if kind != "crypto_LUKS" or types not in (["LUKS1"], ["LUKS2"]) or len(backing) != 1:
        raise ValueError("Cannot verify the active LUKS mapping.")
    mapped_backing = Path(backing[0]).resolve(strict=True)
    if (
        subprocess.run(
            ["lsblk", "-dnro", "MAJ:MIN", str(mapped_backing)],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
        != parent_id
    ):
        raise ValueError("Active LUKS mapping uses a different backing device.")
    luks_uuid = subprocess.run(
        ["blkid", "-p", "-s", "UUID", "-o", "value", str(parent)],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if (
        not re.fullmatch(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", luks_uuid)
        or luks_uuid == uuid
    ):
        raise ValueError("Invalid LUKS container UUID.")
    mapping = (SYS / "dev/block" / device_id / "dm/name").read_text().strip()
    alias = (DEV / "mapper" / mapping).resolve(strict=True)
    if (
        not mapping
        or subprocess.run(
            ["lsblk", "-dnro", "MAJ:MIN", str(alias)], check=True, capture_output=True, text=True
        ).stdout.strip()
        != device_id
    ):
        raise ValueError("Cannot verify the active LUKS mapper alias.")
    return BtrfsDevice(device, uuid, device_id, luks_uuid)


def fstab_entries() -> list[tuple[str, str, str, str]]:
    path = ETC / "fstab"
    result = subprocess.run(
        [
            "findmnt",
            "--fstab",
            "--tab-file",
            str(path),
            "-rn",
            "-o",
            "SOURCE,TARGET,FSTYPE,OPTIONS",
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode and not (
        result.returncode == 1
        and not result.stdout
        and not result.stderr
        and not any(
            line.strip() and not line.lstrip().startswith("#")
            for line in path.read_text().splitlines()
        )
    ):
        result.check_returncode()
    if result.stderr:
        raise ValueError(f"Cannot parse fstab: {result.stderr.strip()}")
    entries: list[tuple[str, str, str, str]] = []
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        fields = line.split()
        if len(fields) != 4:
            raise ValueError("Malformed fstab entry; preserve it and resolve the conflict.")
        entries.append((fields[0], fields[1], fields[2], fields[3]))
    return entries


def swap_units(*, include_services: bool = False) -> list[tuple[str, str]]:
    result = subprocess.run(
        [
            "systemctl",
            "list-unit-files",
            "--type=swap,service" if include_services else "--type=swap",
            "--no-legend",
            "--no-pager",
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode and not (
        result.returncode == 1 and not result.stdout and not result.stderr
    ):
        result.check_returncode()
    if result.stderr:
        raise ValueError(f"Cannot inspect swap units: {result.stderr.strip()}")
    units: list[tuple[str, str]] = []
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        fields = line.split()
        if len(fields) < 2:
            raise ValueError("Incomplete swap-unit inventory.")
        units.append((fields[0], fields[1]))
    return units


def independently_managed_swap(entries: list[tuple[str, str, str, str]]) -> bool:
    active = subprocess.run(
        ["swapon", "--show=NAME", "--noheadings", "--raw"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.splitlines()
    active.extend(source for source, _, kind, _ in entries if kind == "swap")
    for unit, _ in swap_units():
        path = subprocess.run(
            ["systemctl", "show", "--property=What", "--value", unit],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
        if not path:
            raise ValueError(f"Cannot inspect the swap device for {unit}.")
        active.append(path)
    for path in active:
        if path and path != str(SWAP_FILE) and not re.fullmatch(r"/dev/zram[0-9]+", path):
            print(
                f"Existing independently managed swap ({path}); configure hibernation manually, left untouched."
            )
            return True
    return False


def persistent_cmdline(parser: Path) -> str:
    return subprocess.run(
        [sys.executable, "-I", "-B", str(parser), "hibernation"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()


def memory_kib() -> int:
    match = re.search(r"(?m)^MemTotal:\s+(\d+)\s+kB$", (PROC / "meminfo").read_text())
    if match is None or int(match[1]) <= 0:
        raise ValueError("Cannot read physical RAM size.")
    return int(match[1])


def validate_swap_mount(device: BtrfsDevice) -> None:
    identity = subprocess.run(
        ["findmnt", "-rn", "-o", "TARGET,FSTYPE,UUID,FSROOT", "--mountpoint", str(SWAP_MOUNT)],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if identity != f"{SWAP_MOUNT} btrfs {device.uuid} /@swap":
        raise ValueError("Swap mount must be the root filesystem's exact /@swap subvolume.")
    target = SWAP_FILE if SWAP_FILE.exists() or SWAP_FILE.is_symlink() else SWAP_MOUNT
    mount = subprocess.run(
        ["findmnt", "-rn", "-o", "TARGET", "--target", str(target)],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if mount != str(SWAP_MOUNT):
        raise ValueError("Swapfile is on a nested or unverifiable mount.")
    if SWAP_FILE.exists() or SWAP_FILE.is_symlink():
        info = SWAP_FILE.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise ValueError("Swapfile must be a regular non-symlink file with one link.")


def check_swap_fstab(
    entries: list[tuple[str, str, str, str]], device: BtrfsDevice, subvolume_id: str
) -> tuple[bool, bool]:
    mounted = swapped = False
    for source, target, kind, options in entries:
        target = str(Path(target).resolve()) if target.startswith("/") else target
        source = (
            str(Path(source).resolve())
            if source.startswith("/") and not Path(source).is_relative_to(DEV)
            else source
        )
        if target == str(SWAP_MOUNT):
            uuid = (
                source.removeprefix("UUID=")
                if source.startswith("UUID=")
                else subprocess.run(
                    ["lsblk", "-dnro", "UUID", source], check=True, capture_output=True, text=True
                ).stdout.strip()
                if Path(source).is_relative_to(DEV)
                else ""
            )
            tokens = options.split(",")
            subvols = [token for token in tokens if token.startswith(("subvol=", "subvolid="))]
            if (
                kind != "btrfs"
                or uuid.lower() != device.uuid.lower()
                or not subvols
                or any(
                    token
                    not in (
                        "subvol=@swap",
                        "subvol=/@swap",
                        f"subvolid={subvolume_id}" if subvolume_id else "",
                    )
                    for token in subvols
                )
                or set(tokens) & {"ro", "noauto", "bind", "rbind"}
            ):
                raise ValueError(
                    "Conflicting fstab swap mount; preserve it and configure /@swap manually."
                )
            mounted = True
        if source == str(SWAP_FILE) or target == str(SWAP_FILE):
            if (
                source != str(SWAP_FILE)
                or kind != "swap"
                or target not in ("none", "swap")
                or "noauto" in options.split(",")
            ):
                raise ValueError("Conflicting fstab swapfile entry.")
            swapped = True
    return mounted, swapped


def request_rebuild(state: Path) -> None:
    descriptor = os.open(
        state / "initramfs.pending", os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600
    )
    with os.fdopen(descriptor, "w") as stream:
        info = os.fstat(stream.fileno())
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_nlink != 1
            or info.st_uid not in (0, int(os.environ["SUDO_UID"]))
        ):
            raise ValueError("Unsafe deferred initramfs marker.")
        os.fchown(stream.fileno(), int(os.environ["SUDO_UID"]), int(os.environ["SUDO_GID"]))
        os.fchmod(stream.fileno(), 0o600)
    # Never clear this request here; Phase 6C's verified rebuild owns completion.


def record_hibernation_retry(pending: Path) -> None:
    descriptor = os.open(
        pending, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600
    )
    with os.fdopen(descriptor, "w") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.getuid():
            raise ValueError("Hibernation retry state requires a safe user-owned regular file.")
        os.fchmod(stream.fileno(), 0o600)
        _ = stream.write(".")


def require_unchanged_fstab(expected: os.stat_result) -> None:
    from lib.policy_files import inspect_file, same_state

    if not same_state(expected, inspect_file(ETC / "fstab")):
        raise ValueError(
            "fstab changed after inspection; preserve it and retry before changing swap."
        )


def configure_btrfs_swap(
    device: BtrfsDevice,
    entries: list[tuple[str, str, str, str]],
    state: Path,
    fstab_state: os.stat_result,
) -> tuple[SetupResult, str]:
    subvolumes = subprocess.run(
        ["btrfs", "subvolume", "list", "/"], check=True, capture_output=True, text=True
    ).stdout
    ids = re.findall(r"(?m)^ID (\d+) gen \d+ top level 5 path @swap$", subvolumes)
    if len(ids) > 1:
        raise ValueError("Cannot identify a unique top-level @swap subvolume.")
    subvolume_id = ids[0] if ids else ""
    if SWAP_MOUNT.is_symlink() or (SWAP_MOUNT.exists() and not SWAP_MOUNT.is_dir()):
        raise ValueError("Swap mount must be a non-symlink directory.")
    mounted = False
    if SWAP_MOUNT.exists():
        result = subprocess.run(["mountpoint", "-q", str(SWAP_MOUNT)], check=False)
        if result.returncode == 0:
            mounted = True
            if not subvolume_id:
                raise ValueError("Swap is mounted without an identified top-level @swap subvolume.")
            validate_swap_mount(device)
        elif result.returncode != 32:
            result.check_returncode()
        elif SWAP_MOUNT.stat().st_ino == 256 or any(SWAP_MOUNT.iterdir()):
            raise ValueError("Unmounted swap path must be an empty ordinary directory.")
    mount_present, swap_present = check_swap_fstab(entries, device, subvolume_id)
    require_unchanged_fstab(fstab_state)
    if not subvolume_id:
        top = Path(tempfile.mkdtemp(prefix="chezmoi-btrfs-top-"))
        mount_attempted = False
        try:
            mount_attempted = True
            _ = subprocess.run(
                ["mount", "-o", "subvolid=5", str(device.device), str(top)], check=True
            )
            identity = subprocess.run(
                ["findmnt", "-rn", "-o", "TARGET,FSTYPE,UUID,FSROOT", "--mountpoint", str(top)],
                check=True,
                capture_output=True,
                text=True,
            ).stdout.strip()
            if (
                identity != f"{top} btrfs {device.uuid} /"
                or (top / "@swap").exists()
                or (top / "@swap").is_symlink()
            ):
                raise ValueError("Cannot verify an empty top-level @swap location.")
            _ = subprocess.run(["btrfs", "subvolume", "create", str(top / "@swap")], check=True)
        finally:
            # A mount can succeed immediately before an interrupt is delivered.
            # Inspect actual state rather than relying on subprocess completion.
            blocked = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT, signal.SIGTERM})
            try:
                if mount_attempted:
                    top_status = subprocess.run(["mountpoint", "-q", str(top)], check=False)
                    if top_status.returncode == 0:
                        _ = subprocess.run(["umount", str(top)], check=True)
                    elif top_status.returncode != 32:
                        top_status.check_returncode()
                top.rmdir()
            finally:
                _ = signal.pthread_sigmask(signal.SIG_SETMASK, blocked)
    if not mounted:
        SWAP_MOUNT.mkdir(exist_ok=True)
        _ = subprocess.run(
            ["mount", "-o", "subvol=@swap", str(device.device), str(SWAP_MOUNT)], check=True
        )
    validate_swap_mount(device)
    require_unchanged_fstab(fstab_state)
    owner = state / "hibernation.swapfile"
    if SWAP_FILE.exists():
        expected = f"{device.uuid} {SWAP_FILE} {SWAP_FILE.stat().st_ino}\n"
        if owner.is_symlink() or not owner.is_file() or owner.read_text() != expected:
            print(
                "Existing swapfile has no matching ownership record; configure hibernation manually, left untouched."
            )
            return SetupResult.MANUAL, ""
    else:
        ram = math.ceil(memory_kib() / 1024**2)
        size = max(2, ram + round(math.sqrt(ram)))
        _ = subprocess.run(
            [
                "btrfs",
                "filesystem",
                "mkswapfile",
                "--size",
                f"{size}G",
                "--uuid",
                "clear",
                str(SWAP_FILE),
            ],
            check=True,
        )
        validate_swap_mount(device)
        descriptor = os.open(owner, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
        with os.fdopen(descriptor, "w") as stream:
            info = os.fstat(stream.fileno())
            if (
                not stat.S_ISREG(info.st_mode)
                or info.st_nlink != 1
                or info.st_uid not in (0, int(os.environ["SUDO_UID"]))
            ):
                raise ValueError("Managed swap ownership record requires a safe regular file.")
            os.fchown(stream.fileno(), int(os.environ["SUDO_UID"]), int(os.environ["SUDO_GID"]))
            os.fchmod(stream.fileno(), 0o600)
            _ = stream.truncate(0)
            _ = stream.write(f"{device.uuid} {SWAP_FILE} {SWAP_FILE.stat().st_ino}\n")
        print(f"Created Btrfs swapfile ({size}G).")
    validate_swap_mount(device)
    offset = subprocess.run(
        ["btrfs", "inspect-internal", "map-swapfile", "-r", str(SWAP_FILE)],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if not re.fullmatch(r"[0-9]+", offset):
        raise ValueError("Btrfs map-swapfile did not return a valid resume offset.")
    active = subprocess.run(
        ["swapon", "--show=NAME", "--noheadings", "--raw"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.splitlines()
    require_unchanged_fstab(fstab_state)
    if str(SWAP_FILE) not in active:
        _ = subprocess.run(["swapon", str(SWAP_FILE)], check=True)
    additions: list[str] = []
    if not mount_present:
        additions.append(
            f"UUID={device.uuid} {SWAP_MOUNT} btrfs defaults,noatime,nodatacow,subvol=@swap 0 0"
        )
    if not swap_present:
        additions.append(f"{SWAP_FILE} none swap defaults 0 0")
    return SetupResult.CONFIGURED, "".join(f"\n{entry}\n" for entry in additions)


def configure_resume(device: BtrfsDevice, state: Path, work: Path, parser: Path) -> None:
    from lib.policy_files import publish_config, rollback_configs, snapshot_config

    directory = ETC / "limine-entry-tool.d"
    directory.mkdir(mode=0o755, exist_ok=True)
    defaults = directory / "01-default.conf"
    managed = directory / "50-hibernation.conf"
    paths = (
        sorted((SHARE / "limine-entry-tool.d").glob("*.conf"))
        + [ETC / "limine-entry-tool.conf"]
        + sorted(set(directory.glob("*.conf")) | {defaults, managed})
        + [ETC / "default/limine"]
    )
    features = {defaults, managed, directory / "20-quiet-boot.conf", directory / "zswap.conf"}
    baseline = any(
        re.search(
            r"(?m)^\s*KERNEL_CMDLINE\[default\]\s*" + (r"=" if path in features else r"\+?="),
            path.read_text(),
        )
        for path in paths
        if path.exists()
    )
    if not baseline or defaults.is_file():
        config = snapshot_config(defaults, work / "defaults.before")
        candidate = work / "defaults.next"
        content = config.backup.read_text()
        if not baseline:
            original = (ETC / "kernel/cmdline").read_text().strip()
            if not original or "\n" in original:
                raise ValueError(
                    "No single-line persistent Limine baseline; configure it manually."
                )
            content = 'KERNEL_CMDLINE[default]= "' + original.replace('"', r"\"") + '"\n' + content
        _ = candidate.write_text(content)
        _ = subprocess.run(
            [sys.executable, "-I", "-B", str(parser), "deduplicate-file", str(candidate)],
            check=True,
        )
        if config.original is None or candidate.read_bytes() != config.backup.read_bytes():
            request_rebuild(state)
            _ = publish_config(config, candidate.read_bytes())
    offset = subprocess.run(
        ["btrfs", "inspect-internal", "map-swapfile", "-r", str(SWAP_FILE)],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if not re.fullmatch(r"[0-9]+", offset):
        raise ValueError("Invalid final Btrfs resume offset.")
    config = snapshot_config(managed, work / "resume.before")
    candidate = work / "resume.next"
    _ = candidate.write_bytes(config.backup.read_bytes())
    params = f"hibernate.compressor=lz4 resume=UUID={device.uuid} resume_offset={offset}"
    _ = subprocess.run(
        [
            sys.executable,
            "-I",
            "-B",
            str(parser),
            "fragment-file",
            managed.name,
            str(candidate),
            params,
        ],
        check=True,
    )
    try:
        changed = config.original is None or candidate.read_bytes() != config.backup.read_bytes()
        if changed:
            request_rebuild(state)
            _ = publish_config(config, candidate.read_bytes())
        # Re-evaluate precedence after publication: later defaults must not
        # suppress this resume owner while the workflow reports completion.
        _ = persistent_cmdline(parser)
    except BaseException:
        rollback_configs([config])
        raise
    if changed:
        print("Configured managed Btrfs swapfile resume.")


def configure_zswap(state: Path, work: Path, parser: Path) -> None:
    from lib.policy_files import publish_config, rollback_configs, snapshot_config

    previous = persistent_cmdline(parser)
    fragment = ETC / "limine-entry-tool.d/zswap.conf"
    if (
        any(token.startswith("zswap.") for token in previous.split())
        or fragment.exists()
        or fragment.is_symlink()
        or memory_kib() < 30 * 1024**2
    ):
        return
    if any((SYS / "block").glob("zram[0-9]*")):
        return
    active = subprocess.run(
        ["swapon", "--show=NAME", "--noheadings", "--raw"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.splitlines()
    if any(re.fullmatch(r"/dev/zram[0-9]+", path) for path in active):
        return
    for base in (ETC, Path("/run"), Path("/usr/lib")):
        paths = [
            base / "systemd/zram-generator.conf",
            *sorted((base / "systemd/zram-generator.conf.d").glob("*.conf")),
        ]
        if any(path.exists() or path.is_symlink() for path in paths):
            return
    if any(
        (ETC / path).exists() or (ETC / path).is_symlink()
        for path in ("default/zramswap", "default/zram-config", "conf.d/zram")
    ):
        return
    for unit, status in swap_units(include_services=True):
        if unit.endswith("@.service"):
            continue
        if unit.endswith(".swap"):
            path = subprocess.run(
                ["systemctl", "show", "--property=What", "--value", unit],
                check=True,
                capture_output=True,
                text=True,
            ).stdout.strip()
            if re.fullmatch(r"/dev/zram[0-9]+", path):
                return
        elif "zram" in unit and status in (
            "enabled",
            "enabled-runtime",
            "linked",
            "linked-runtime",
            "generated",
        ):
            return
    if any(
        re.fullmatch(r"/dev/zram[0-9]+", source)
        for source, _, kind, _ in fstab_entries()
        if kind == "swap"
    ):
        return
    config = snapshot_config(fragment, work / "zswap.before")
    try:
        request_rebuild(state)
        _ = publish_config(
            config, b'KERNEL_CMDLINE[default]+=" zswap.enabled=1 zswap.compressor=lz4"\n'
        )
        updated = persistent_cmdline(parser).split()
        retained = [token for token in updated if not token.startswith("zswap.")]
        if (
            updated.count("zswap.enabled=1") != 1
            or updated.count("zswap.compressor=lz4") != 1
            or len(updated) != len(retained) + 2
            or retained != previous.split()
        ):
            raise ValueError("Zswap verification changed unrelated persistent arguments.")
    except BaseException:
        rollback_configs([config])
        raise
    print("Configured Zswap for next boot; reboot required for activation.")


def configure_sleep(work: Path) -> None:
    from lib.policy_files import publish_config, snapshot_config

    files = {
        "systemd/sleep.conf.d/hibernation.conf": "[Sleep]\nAllowSuspend=yes\nAllowHibernation=yes\nAllowSuspendThenHibernate=yes\nHibernateDelaySec=30min\nAllowHybridSleep=yes\nHibernateMode=platform shutdown\nHibernateOnACPower=yes\n",
        "systemd/logind.conf.d/hibernation.conf": "[Login]\nHandleSuspendKey=ignore\nHandleHibernateKey=ignore\nHandleLidSwitch=suspend-then-hibernate\n",
        "udev/rules.d/90-disable-usb-wake.rules": '# Disable wakeup on USB host controllers, independent of ACPI device names.\nACTION=="add|change", SUBSYSTEM=="pci", ATTR{class}=="0x0c03*", TEST=="power/wakeup", ATTR{power/wakeup}="disabled"\n',
    }
    if math.ceil(memory_kib() / 1024**2) > 30:
        files["tmpfiles.d/hibernation_image_size.conf"] = (
            "#    Path                   Mode UID  GID  Age Argument\nw    /sys/power/image_size  -    -    -    -   0\n"
        )
    for index, (name, content) in enumerate(files.items()):
        path = ETC / name
        path.parent.mkdir(parents=True, mode=0o755, exist_ok=True)
        config = snapshot_config(path, work / f"sleep-{index}")
        changed = publish_config(config, content.encode(), mode=0o644)
        if changed:
            print(f"Configured {path}.")
    _ = subprocess.run(["udevadm", "control", "--reload-rules"], check=True)
    _ = subprocess.run(
        [
            "udevadm",
            "trigger",
            "--action=change",
            "--subsystem-match=pci",
            "--attr-match=class=0x0c03*",
        ],
        check=True,
    )
    _ = subprocess.run(["udevadm", "settle"], check=True)


def apply_hibernation(state: Path, parser: Path) -> SetupResult:
    from lib.policy_files import inspect_file, publish_config, rollback_configs, snapshot_config

    if os.geteuid() != 0:
        raise PermissionError("System hibernation configuration requires root.")
    info = state.lstat()
    if (
        not stat.S_ISDIR(info.st_mode)
        or info.st_uid != int(os.environ["SUDO_UID"])
        or info.st_mode & 0o022
    ):
        raise ValueError(
            "Hibernation state requires a safe directory owned by the regular account."
        )
    initial_fstab = inspect_file(ETC / "fstab")
    if initial_fstab is None:
        raise ValueError("fstab is missing; resolve it before configuring swap.")
    entries = fstab_entries()
    if independently_managed_swap(entries):
        return SetupResult.MANUAL
    try:
        device = inspect_btrfs_device(Path("/"))
    except ManualSetup as error:
        print(f"{error} Configure hibernation manually; existing state was preserved.")
        return SetupResult.MANUAL
    try:
        cmdline = persistent_cmdline(parser)
    except subprocess.CalledProcessError as error:
        diagnostic = cast("str | None", error.stderr)
        reason = diagnostic.strip() if diagnostic else str(error)
        print(f"WARNING: Persistent Limine arguments need manual review; setup deferred: {reason}")
        return SetupResult.DEFERRED
    if any(
        token.startswith(("resume=", "resume_offset=")) or token in ("noresume", "hibernate=no")
        for token in cmdline.split()
    ):
        print("Existing external resume policy; configure hibernation manually, left untouched.")
        return SetupResult.MANUAL
    with tempfile.TemporaryDirectory(prefix="chezmoi-hibernation-") as temporary:
        work = Path(temporary)
        fstab = snapshot_config(ETC / "fstab", work / "fstab.before")
        require_unchanged_fstab(initial_fstab)
        try:
            outcome, additions = configure_btrfs_swap(device, entries, state, initial_fstab)
            if outcome != SetupResult.CONFIGURED:
                return outcome
            if additions:
                _ = publish_config(fstab, fstab.backup.read_bytes() + additions.encode())
                _ = subprocess.run(["systemctl", "daemon-reload"], check=True)
            if inspect_btrfs_device(SWAP_FILE) != device:
                raise ValueError("Swapfile device changed; refusing to publish resume parameters.")
            configure_resume(device, state, work, parser)
        except BaseException:
            rollback_configs([fstab])
            if fstab.published is not None:
                _ = subprocess.run(["systemctl", "daemon-reload"], check=False)
            raise
        try:
            configure_zswap(state, work, parser)
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            print(f"WARNING: Optional Zswap setup skipped; hibernation remains configured: {error}")
        configure_sleep(work)
    return SetupResult.CONFIGURED


def configure_nvidia_sleep(source_dir: Path) -> None:
    info = subprocess.run(["lspci", "-nn"], check=True, capture_output=True, text=True).stdout
    if not any(
        "NVIDIA Corporation" in line
        and re.search(
            r"VGA compatible controller|3D controller|Display controller", line, re.IGNORECASE
        )
        for line in info.splitlines()
    ):
        return
    declarations = cast(
        "dict[str, object]",
        tomllib.loads((source_dir.parent / "mise/config.nvidia-sleep.toml").read_text()),
    )
    bootstrap = cast("dict[str, object]", declarations["bootstrap"])
    services = cast("dict[str, dict[str, str | bool]]", bootstrap["services"])
    selected: dict[str, dict[str, str | bool]] = {}
    for unit, declaration in services.items():
        load = subprocess.run(
            ["systemctl", "show", "--property=LoadState", "--value", "--", unit],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
        if load in ("loaded", "masked"):
            selected[unit] = declaration
        elif load != "not-found":
            raise ValueError(f"Cannot inspect NVIDIA unit {unit}: LoadState={load}")
    if selected:
        with tempfile.TemporaryDirectory(prefix="chezmoi-nvidia-sleep-") as temporary:
            directory = Path(temporary)
            config = directory / "mise/config.nvidia-sleep.toml"
            config.parent.mkdir()
            content = f"min_version = {json.dumps(declarations['min_version'])}\n"
            for unit, declaration in selected.items():
                content += f"\n[bootstrap.services.{json.dumps(unit)}]\n"
                content += "".join(
                    f"{key} = {json.dumps(value)}\n" for key, value in declaration.items()
                )
            _ = config.write_text(content)
            env = os.environ.copy()
            for name in (
                "MISE_CONFIG_FILE",
                "MISE_GLOBAL_CONFIG_FILE",
                "MISE_SYSTEM_CONFIG_FILE",
                "MISE_OVERRIDE_CONFIG_FILENAMES",
                "MISE_ENV",
            ):
                _ = env.pop(name, None)
            env.update(
                MISE_CONFIG_DIR="/dev/null",
                MISE_SYSTEM_CONFIG_DIR="/dev/null",
                MISE_AUTO_ENV="false",
                MISE_CEILING_PATHS=str(directory.parent),
                MISE_TRUSTED_CONFIG_PATHS=str(config.parent),
            )
            _ = subprocess.run(
                ["mise", "--env", "nvidia-sleep", "bootstrap", "services", "apply", "--yes"],
                cwd=directory,
                env=env,
                check=True,
            )
    pci = subprocess.run(
        ["lspci", "-Dnnd", "10de:"], check=True, capture_output=True, text=True
    ).stdout.splitlines()
    address = pci[0].split()[0] if pci else ""
    if not address:
        listing = subprocess.run(["lspci", "-D"], check=True, capture_output=True, text=True).stdout
        address = next(
            (
                line.split()[0]
                for line in listing.splitlines()
                if re.search(r"NVIDIA.*(VGA|3D|Display)", line, re.IGNORECASE)
            ),
            "",
        )
    if address:
        if not re.fullmatch(r"[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7]", address):
            raise ValueError("Invalid NVIDIA PCI address.")
        result = subprocess.run(
            [
                "sudo",
                "-n",
                sys.executable,
                "-B",
                str(Path(__file__).resolve()),
                "--nvidia-pm",
                address,
                str(source_dir),
            ],
            check=True,
            capture_output=True,
            text=True,
        )
        for message in result.stdout.splitlines():
            logger.info(message)
    else:
        logger.warning("Cannot detect the NVIDIA PCI address; power configuration left unchanged.")


def terminate(_signum: int, _frame: object) -> None:
    raise SystemExit(143)


def main() -> int:
    privileged = sys.argv[1:2] in (["--configure"], ["--nvidia-pm"])
    if privileged and len(sys.argv) != 4:
        print("ERROR: Privileged hibernation setup requires its source directory.", file=sys.stderr)
        return 1
    source_dir = Path(sys.argv[3]) if privileged else Path(os.environ["CHEZMOI_SOURCE_DIR"])
    if not source_dir.is_absolute():
        print("ERROR: Chezmoi must supply an absolute source directory.", file=sys.stderr)
        return 1
    sys.path.insert(0, str(source_dir / ".chezmoitemplates"))
    parser = source_dir / ".chezmoitemplates/lib/limine_cmdline.py"
    _ = signal.signal(signal.SIGTERM, terminate)
    if privileged:
        try:
            if sys.argv[1] == "--configure" and len(sys.argv) == 4:
                outcome = apply_hibernation(Path(sys.argv[2]), parser)
                print(f"HIBERNATION_RESULT={outcome.name}")
                return 0
            if sys.argv[1] == "--nvidia-pm" and len(sys.argv) == 4:
                from lib.policy_files import publish_config, snapshot_config

                if os.geteuid() != 0 or not re.fullmatch(
                    r"[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7]", sys.argv[2]
                ):
                    raise ValueError("Invalid privileged NVIDIA power invocation.")
                path = ETC / "tmpfiles.d/nvidia_pm.conf"
                path.parent.mkdir(parents=True, exist_ok=True)
                with tempfile.TemporaryDirectory() as temporary:
                    config = snapshot_config(path, Path(temporary) / "before")
                    if publish_config(
                        config,
                        f"# NVIDIA power management\nw /sys/bus/pci/devices/{sys.argv[2]}/power/control - - - - auto\n".encode(),
                        mode=0o644,
                    ):
                        print(f"Configured NVIDIA power management for PCI {sys.argv[2]}.")
                return 0
            raise ValueError("Unsupported privileged hibernation arguments.")
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            traceback.print_exc()
            return error.returncode if isinstance(error, subprocess.CalledProcessError) else 1
    from lib.provision_logging import configure_logging

    file_sink = None
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "chezmoi"
    pending = state / "hibernation.pending"
    retry_recorded = False
    try:
        file_sink = configure_logging()
        if sys.argv[1:] or os.geteuid() == 0:
            raise ValueError(
                "Run hibernation provisioning as the regular account without arguments."
            )
        if not os.access(LIMINE, os.X_OK):
            pending.unlink(missing_ok=True)
            return 0
        filesystem = subprocess.run(
            ["findmnt", "-n", "-o", "FSTYPE", "/"], check=True, capture_output=True, text=True
        ).stdout.strip()
        if not filesystem or "\n" in filesystem:
            raise ValueError("Cannot inspect one root filesystem type.")
        if filesystem != "btrfs":
            pending.unlink(missing_ok=True)
            return 0
        chassis = subprocess.run(
            ["hostnamectl", "chassis"], check=True, capture_output=True, text=True
        ).stdout.strip()
        if chassis not in ("laptop", "notebook"):
            pending.unlink(missing_ok=True)
            return 0
        if shutil.which("mkinitcpio") is None:
            record_hibernation_retry(pending)
            logger.warning("mkinitcpio unavailable; hibernation setup remains pending.")
            return 0
        record_hibernation_retry(pending)
        retry_recorded = True
        _ = subprocess.run(["sudo", "-v"], check=True)
        result = subprocess.run(
            [
                "sudo",
                "-n",
                sys.executable,
                "-B",
                str(Path(__file__).resolve()),
                "--configure",
                str(state),
                str(source_dir),
            ],
            check=False,
            capture_output=True,
            text=True,
        )
        result.check_returncode()
        messages = result.stdout.splitlines()
        if not messages or messages[-1] not in {
            f"HIBERNATION_RESULT={outcome.name}" for outcome in SetupResult
        }:
            raise ValueError("Hibernation configuration did not report a verified outcome.")
        outcome = SetupResult[messages[-1].split("=", 1)[1]]
        if result.stderr:
            logger.debug("System diagnostic:\n{}", result.stderr.rstrip())
        for message in messages[:-1]:
            if message.startswith("WARNING: "):
                logger.warning(message.removeprefix("WARNING: "))
            else:
                logger.info(message)
        if outcome == SetupResult.MANUAL:
            pending.unlink(missing_ok=True)
            return 0
        if outcome == SetupResult.DEFERRED:
            return 0
        configure_nvidia_sleep(source_dir)
        pending.unlink(missing_ok=True)
        return 0
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        status = error.returncode if isinstance(error, subprocess.CalledProcessError) else 1
        try:
            if isinstance(error, subprocess.CalledProcessError):
                diagnostic = cast("str | None", error.stderr)
                reason = (
                    diagnostic.strip().splitlines()[-1]
                    if diagnostic and diagnostic.strip()
                    else str(error)
                )
                logger.error("Hibernation setup failed (exit {}): {}", status, reason)
                if diagnostic:
                    logger.debug("System diagnostic:\n{}", diagnostic.rstrip())
            else:
                logger.opt(exception=True).error("Hibernation setup stopped: {}", error)
            if not retry_recorded:
                record_hibernation_retry(pending)
        except OSError, ValueError:
            if file_sink is not None:
                logger.remove(file_sink)
        return status
    except KeyboardInterrupt:
        if not retry_recorded:
            record_hibernation_retry(pending)
        logger.warning("Hibernation setup interrupted; reapply when ready.")
        return 130


if __name__ == "__main__":
    status = main()
    sys.exit(status if status >= 0 else 128 - status)
