#!/usr/bin/env bash

# data: distroFamily={{ .distroFamily | quote }}
# Packaged user units, one-shot maintenance, and native mise services/firewall/login shell.
# mise.toml: {{ include "../mise.toml" | sha256sum }}
# Exit codes: 0 (success), 1 (failure)

set -euo pipefail

shopt -s nullglob globstar

{{ include ".chezmoitemplates/lib/common.sh" }}

# shellcheck disable=SC2034
readonly -a USER_SERVICES=(
  "gnome-keyring-daemon.socket"
  "gnome-keyring-daemon.service"
  "mpris-proxy"
  "udiskie"
)


if ! keep_sudo_alive; then
  die "Failed to keep sudo alive"
fi

# Native mise user services create new dev.mise.* units; they cannot manage
# these existing packaged services/socket without changing their identity.
converge_packaged_user_services() {
  local service load_state

  for service in "${USER_SERVICES[@]}"; do
    if ! load_state=$(systemctl --user show --property=LoadState --value -- "$service"); then
      log WARN "Failed to inspect $service (user)"
      continue
    fi
    case "$load_state" in
      not-found)
        log SKIP "$service (user) not available"
        continue
        ;;
      loaded|masked) ;;
      *)
        log WARN "Cannot apply $service (user): unexpected LoadState=$load_state"
        continue
        ;;
    esac

    if systemctl --user unmask -- "$service" &&
      systemctl --user enable --now -- "$service"; then
      log INFO "${COLOR_GREEN}${service}${COLOR_RESET} enabled and running (user)"
    else
      log WARN "Failed to converge $service (user)"
    fi
  done
}


update_locate_database() {
  if ! command_exists updatedb; then
    log SKIP "updatedb not available"
    return 0
  fi

  log INFO "Updating locate database"

  if sudo updatedb >/dev/null 2>&1; then
    log INFO "Locate database updated"
  else
    log WARN "updatedb encountered issues"
  fi

  return 0
}

main() {
  print_box "Services"
  log STEP "Configuring services"

  converge_packaged_user_services
  update_locate_database

  # Packages and database initialization precede native service convergence.
  # Leave NVIDIA environment selection to the gated hibernation phase.
  if ! (
    cd {{ .chezmoi.workingTree | quote }} || exit 1
    MISE_TRUSTED_CONFIG_PATHS="$PWD/mise.toml" \
      mise --env '' bootstrap --only services,firewall,user --yes
  ); then
    die "Failed to apply system services/firewall/login shell with mise"
  fi
}

main "$@"
