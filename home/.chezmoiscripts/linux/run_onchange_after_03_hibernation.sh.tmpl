#!/usr/bin/env bash
# 03_hibernation.sh - Configure laptop swap, resume, sleep, and NVIDIA power management
# Exit codes: 0 (success or skipped), 1 (failure)

# setup-hibernation: {{ .setupHibernation }}
# SETUP_HIBERNATION: {{ get (.chezmoi.config.scriptEnv | default dict) "SETUP_HIBERNATION" | default "1" | quote }}
# SKIP_PACKAGES: {{ ternary "1" "0" (eq (env "SKIP_PACKAGES") "1") }}
{{ $stateHome := env "XDG_STATE_HOME" | default (joinPath .chezmoi.homeDir ".local/state") -}}
# retry-generation: {{ with stat (joinPath $stateHome "chezmoi/hibernation.pending") }}{{ .size }}{{ else }}0{{ end }}

set -euo pipefail

shopt -s nullglob globstar

{{ include ".chezmoitemplates/lib/common.sh" }}
{{ include ".chezmoitemplates/lib/snapboot.sh" }}
{{ include ".chezmoitemplates/lib/hibernation.sh" }}

readonly HIBERNATION_PENDING_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/hibernation.pending"

clear_hibernation_retry() {
  rm -f -- "$HIBERNATION_PENDING_FILE" || die "Failed to clear hibernation retry state"
}

defer_hibernation_setup() {
  # One byte per deferral changes the rendered onchange hash on the next apply,
  # including consecutive failures. A stable boolean marker would retry only once.
  if ! (
    umask 077
    mkdir -p -- "${HIBERNATION_PENDING_FILE%/*}" && printf '.' >> "$HIBERNATION_PENDING_FILE"
  ); then
    die "Failed to record pending hibernation setup"
  fi
  log INFO "Hibernation setup remains pending; the next apply will retry"
}

main() {
  local gpu_info
  local ram_size

  if [[ "${SKIP_PACKAGES:-0}" == "1" ]]; then
    log INFO "Skipping hibernation setup (package installation is disabled)"
    return 0
  fi

  # Exit early if hibernation setup is disabled
  if [[ "${SETUP_HIBERNATION:-1}" != "1" ]]; then
    log INFO "Skipping hibernation setup (disabled in configuration)"
    clear_hibernation_retry
    return 0
  fi

  if [[ ! -x /usr/bin/limine ]]; then
    log WARN "Unsupported bootloader (only Limine is supported), skipping hibernation setup"
    clear_hibernation_retry
    return 0
  fi

  local btrfs_status=0
  check_btrfs || btrfs_status="$?"
  case "$btrfs_status" in
  0) ;;
  1)
    log SKIP "Root filesystem is not btrfs, skipping hibernation setup"
    clear_hibernation_retry
    return 0
    ;;
  *)
    log ERROR "$LAST_ERROR"
    defer_hibernation_setup
    return 1
    ;;
  esac

  if ! is_laptop; then
    if [[ -n "$LAST_ERROR" ]]; then
      log ERROR "$LAST_ERROR"
      defer_hibernation_setup
      return 1
    fi
    log SKIP "Not a laptop, skipping hibernation setup"
    clear_hibernation_retry
    return 0
  fi

  if ! command_exists mkinitcpio; then
    log WARN "mkinitcpio not found, deferring hibernation setup"
    defer_hibernation_setup
    return 0
  fi

  print_box "Hibernation"
  log STEP "Hibernation Setup"

  if ! keep_sudo_alive; then
    die "Failed to keep sudo alive"
  fi

  local setup_result=0
  (
    local fstab_snapshot_dir=""
    local fstab_changed=false
    local temp_mount=""

    trap '
      if [[ -n "$temp_mount" ]]; then
        if mountpoint -q "$temp_mount" 2>/dev/null; then
          sudo umount "$temp_mount" >/dev/null 2>&1 || true
        fi
        rmdir -- "$temp_mount" 2>/dev/null || true
      fi
      if [[ -n "$fstab_snapshot_dir" ]]; then
        rm -rf -- "$fstab_snapshot_dir" || true
      fi
    ' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    setup_hibernation || setup_result="$?"
    local error_msg="$LAST_ERROR"

    if [[ "$setup_result" -ne 0 ]] && [[ "$fstab_changed" = true ]]; then
      if ! cmp -s -- "$fstab_snapshot_dir/expected" /etc/fstab; then
        log WARN "Skipped /etc/fstab rollback: contents changed unexpectedly"
      elif ! sudo cp -- "$fstab_snapshot_dir/before" /etc/fstab 2>/dev/null; then
        die "Hibernation setup failed: $error_msg (failed to restore /etc/fstab)"
      else
        log INFO "Restored /etc/fstab from this invocation's snapshot"
        if ! reload_systemd_daemon; then
          log WARN "Failed to reload systemd after fstab rollback: $LAST_ERROR"
        fi
      fi
    fi

    case "$setup_result" in
    0) ;;
    3) exit 3 ;;
    2)
      log SKIP "Hibernation setup incomplete: $error_msg"
      exit 2
      ;;
    1)
      die "Hibernation setup failed: $error_msg"
      ;;
    *)
      die "Unexpected return code from setup_hibernation: $setup_result"
      ;;
    esac
  ) || setup_result="$?"

  case "$setup_result" in
  0) ;;
  2) defer_hibernation_setup; return 0 ;;
  3) clear_hibernation_retry; return 0 ;;
  *) defer_hibernation_setup; return "$setup_result" ;;
  esac

  configure_zswap || log WARN "Optional zswap setup skipped; hibernation remains configured"

  if ! write_system_config "/etc/systemd/sleep.conf.d/hibernation.conf" <<'EOF'; then
[Sleep]
AllowSuspend=yes
AllowHibernation=yes
AllowSuspendThenHibernate=yes
HibernateDelaySec=30min
AllowHybridSleep=yes
HibernateMode=platform shutdown
HibernateOnACPower=yes
EOF
    die "Failed to write systemd sleep config: $LAST_ERROR"
  fi
  log INFO "Configured systemd sleep"

  if ! write_system_config "/etc/systemd/logind.conf.d/hibernation.conf" <<'EOF'; then
[Login]
HandleSuspendKey=ignore
HandleHibernateKey=ignore
HandleLidSwitch=suspend-then-hibernate
EOF
    die "Failed to write systemd logind config: $LAST_ERROR"
  fi
  log INFO "Configured systemd logind"

  if ! write_system_config "/etc/udev/rules.d/90-disable-usb-wake.rules" <<'EOF'; then
# Disable wakeup on USB host controllers, independent of ACPI device names.
ACTION=="add|change", SUBSYSTEM=="pci", ATTR{class}=="0x0c03*", TEST=="power/wakeup", ATTR{power/wakeup}="disabled"
EOF
    die "Failed to write USB wakeup config: $LAST_ERROR"
  fi

  if ! sudo udevadm control --reload-rules ||
    ! sudo udevadm trigger --action=change --subsystem-match=pci --attr-match='class=0x0c03*' ||
    ! sudo udevadm settle; then
    die "Failed to apply USB wakeup rules"
  fi
  log INFO "Disabled USB controller wakeup"

  ram_size=$(get_ram_size)
  if [[ "$ram_size" -gt 30 ]]; then
    if ! write_system_config "/etc/tmpfiles.d/hibernation_image_size.conf" <<'EOF'; then
#    Path                   Mode UID  GID  Age Argument
w    /sys/power/image_size  -    -    -    -   0
EOF
      die "Failed to write hibernation image size config: $LAST_ERROR"
    fi
    log INFO "Configured hibernation image size"
  fi

  gpu_info=$(get_gpu_info)
  if [[ "$gpu_info" = *"NVIDIA Corporation"* ]]; then
    log INFO "Detected NVIDIA GPU, configuring power management"

{{ template "nvidia-sleep-services" . }}

    local nvidia_pci
    nvidia_pci=$(get_nvidia_pci_address)

    if [[ -n "$nvidia_pci" ]]; then
      write_system_config "/etc/tmpfiles.d/nvidia_pm.conf" <<EOF || die "Failed to write NVIDIA power management config: $LAST_ERROR"
# NVIDIA power management
w /sys/bus/pci/devices/${nvidia_pci}/power/control - - - - auto
EOF
      log INFO "Configured NVIDIA power management for PCI $nvidia_pci"
    else
      log WARN "Failed to detect NVIDIA GPU PCI address"
    fi

  fi

  clear_hibernation_retry
  log INFO "Hibernation setup completed"
}

main "$@"
