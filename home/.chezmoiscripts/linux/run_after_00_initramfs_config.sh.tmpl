#!/usr/bin/env bash
# Configure systemd initramfs for opted-in laptop hibernation before boot changes.
# Runs on every apply so failed preflights retry; identical content never rebuilds.

set -euo pipefail

{{ include ".chezmoitemplates/lib/common.sh" }}
{{ include ".chezmoitemplates/lib/snapboot.sh" }}

main() {
  if [[ "${SETUP_HIBERNATION:-1}" != "1" ]]; then
    log SKIP "Hibernation disabled, preserving the existing initramfs configuration"
    return 0
  fi
  if ! is_laptop; then
    log SKIP "Not a laptop, preserving the existing initramfs configuration"
    return 0
  fi
  if [[ ! -x /usr/bin/limine ]] || ! command_exists mkinitcpio; then
    log SKIP "Limine/mkinitcpio unavailable, skipping initramfs configuration"
    return 0
  fi
  if ! check_btrfs; then
    log SKIP "Root filesystem is not Btrfs, skipping initramfs configuration"
    return 0
  fi
  keep_sudo_alive || die "Cannot inspect initramfs prerequisites: $LAST_ERROR"
  configure_systemd_initramfs || die "Cannot configure systemd initramfs: $LAST_ERROR"
}

main "$@"
