#!/usr/bin/env bash
{{ if .personal -}}
# Install upstream MacTahoe themes; Noctalia generates its custom theme on demand.
# OFFLINE: {{ env "OFFLINE" | quote }}

set -euo pipefail

{{ include ".chezmoitemplates/lib/common.sh" }}

readonly MACTAHOE_REPO="https://github.com/vinceliuice/MacTahoe-icon-theme.git"
readonly ICONS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons"

if [[ -n "${OFFLINE:-}" ]]; then
  exit 0
fi

[[ "$(id -u)" -ne 0 ]] || die "Do not install user icon themes as root."

for dependency in git gtk-update-icon-cache; do
  command_exists "$dependency" || die "Required command not found: $dependency"
done

install_mactahoe_icons() (
  local work_dir source_dir
  work_dir=$(mktemp -d /tmp/chezmoi-mactahoe.XXXXXXXX) || die "Failed to create MacTahoe work directory"
  trap 'rm -rf -- "$work_dir"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  source_dir="$work_dir/source"

  # Install directly through a space-free alias for upstream's unquoted paths.
  mkdir -p -- "$ICONS_DIR"
  ln -s -- "$ICONS_DIR" "$work_dir/icons"
  if ! git -c core.symlinks=true clone --depth 1 --single-branch -- "$MACTAHOE_REPO" "$source_dir"; then
    die "Failed to clone MacTahoe icon themes"
  fi

  log STEP "Installing default MacTahoe themes"
  if ! bash "$source_dir/install.sh" --dest "$work_dir/icons"; then
    die "Failed to install MacTahoe icon themes"
  fi

  log INFO "Installed MacTahoe icon themes in $ICONS_DIR"
)

install_mactahoe_icons

{{ end -}}
