#!/usr/bin/env bash
# 08_theming.sh - Configure Limine appearance
# GTK theme and color scheme are applied by Noctalia's enabled GTK templates.
# Exit codes: 0 (success), 1 (failure)

set -euo pipefail

{{ include ".chezmoitemplates/lib/common.sh" }}
{{ include ".chezmoitemplates/lib/snapboot.sh" }}

readonly -a LIMINE_OPTIONS=(
  "timeout=0.5"
  "terse=yes"
  "quiet=yes"
  "firmware_logo=yes"
  "interface_help_hidden=yes"
  "mouse=no"
)

configure_limine_options() {
  local boot_directory limine_conf
  local temp_file
  local limine_options
  local original_entries generated_entries

  LAST_ERROR=""

  if ! command_exists limine-entry-tool; then
    LAST_ERROR="limine-entry-tool is not installed"
    return 2
  fi

  if ! boot_directory=$(get_limine_boot_directory); then
    LAST_ERROR="Cannot resolve active Limine boot directory; mount the ESP or configure ESP_PATH"
    return 1
  fi
  validate_limine_config_location "$boot_directory" || return 1
  limine_conf="$boot_directory/limine.conf"

  if ! sudo test -f "$limine_conf"; then
    LAST_ERROR="Limine config not found: $limine_conf"
    return 2
  fi


  temp_file=$(mktemp)


  limine_options="$(printf '%s\n' "${LIMINE_OPTIONS[@]}")"

  # shellcheck disable=SC2024  # temp file is user-owned; only the read needs sudo
  if ! sudo awk -v "limine_options=$limine_options" '
    function emit_missing_options( option_index, option_parts, option_name) {
      for (option_index = 1; option_index <= limine_option_count; option_index++) {
        split(limine_option[option_index], option_parts, "=")
        option_name = option_parts[1]
        if (!(option_name in emitted_options)) {
          print option_name ": " desired_values[option_name]
          emitted_options[option_name] = 1
        }
      }
    }

    function emit_entry_spacing() {
      print ""
      print ""
      print ""
    }

    BEGIN {
      entry_seen = 0
      trim_entry_padding = 0
      limine_option_count = split(limine_options, limine_option, "\n")
      if (limine_option[limine_option_count] == "") {
        limine_option_count--
      }

      for (option_index = 1; option_index <= limine_option_count; option_index++) {
        split(limine_option[option_index], option_parts, "=")
        desired_options[option_parts[1]] = 1
        desired_values[option_parts[1]] = substr(limine_option[option_index], length(option_parts[1]) + 2)
      }
    }

    {
      if (trim_entry_padding && $0 ~ /^[[:space:]]*$/) {
        next
      }
      trim_entry_padding = 0

      if (!entry_seen && $0 ~ /^[[:space:]]*$/) {
        pending_blank_lines++
        next
      }

      if (!entry_seen && $0 ~ /^\//) {
        emit_missing_options()
        emit_entry_spacing()
        pending_blank_lines = 0
        entry_seen = 1
        trim_entry_padding = 1
        print
        next
      }

      if (pending_blank_lines > 0) {
        for (blank_index = 0; blank_index < pending_blank_lines; blank_index++) {
          print ""
        }
        pending_blank_lines = 0
      }

      normalized_line = $0
      sub(/^[[:space:]]*#?[[:space:]]*/, "", normalized_line)
      split(normalized_line, fields, ":")
      option_name = fields[1]
      sub(/[[:space:]]+$/, "", option_name)

      if (option_name in desired_options) {
        if (entry_seen || (option_name in emitted_options)) {
          next
        }

        print option_name ": " desired_values[option_name]
        emitted_options[option_name] = 1
        next
      }

      print
    }

    END {
      emit_missing_options()
    }
  ' "$limine_conf" >"$temp_file"; then
    LAST_ERROR="Failed to transform Limine config"
    rm -f "$temp_file"
    return 1
  fi

  # Limine entry headers start with /; the transform must preserve their count.
  # grep -c returns 1 for no matches. Reject zero counts and read errors alike.
  original_entries=$(sudo grep -c '^/' "$limine_conf") || original_entries=0
  generated_entries=$(grep -c '^/' "$temp_file") || generated_entries=0
  if [[ ! -s "$temp_file" || "$generated_entries" -eq 0 || "$original_entries" -ne "$generated_entries" ]]; then
    LAST_ERROR="Generated Limine config is empty or has inconsistent boot entries"
    rm -f "$temp_file"
    return 1
  fi

  # A lifecycle/content change must not rewrite an already configured boot file.
  if sudo cmp -s -- "$temp_file" "$limine_conf"; then
    rm -f "$temp_file"
    return 0
  fi

  if ! create_backup "$limine_conf" force; then
    local error_msg="$LAST_ERROR"
    LAST_ERROR="Failed to backup limine config: $error_msg"
    rm -f "$temp_file"
    return 1
  fi

  # Queue enrollment before writing so an interrupted apply can retry it.
  if ! request_initramfs_rebuild; then
    rm -f "$temp_file"
    return 1
  fi

  # Stage on the boot filesystem; .conf.new does not match *.conf consumers.
  # Keep boot arguments private while staging, then preserve the original mode.
  # shellcheck disable=SC2024  # temp input is user-owned; only the write needs sudo
  if ! sudo install -m 0600 /dev/null "${limine_conf}.new" ||
    ! sudo tee -- "${limine_conf}.new" <"$temp_file" >/dev/null ||
    ! sudo chmod --reference="$limine_conf" -- "${limine_conf}.new" ||
    ! sudo mv -- "${limine_conf}.new" "$limine_conf"; then
    sudo rm -f -- "${limine_conf}.new" || true
    local error_msg="Failed to write Limine options"
    LAST_ERROR="$error_msg"
    # Staging/rename failures normally leave the original intact.
    if ! sudo test -s "$limine_conf"; then
      if ! restore_backup "$limine_conf"; then
        LAST_ERROR="$error_msg and restore backup failed: $LAST_ERROR"
      else
        LAST_ERROR="$error_msg (backup restored)"
      fi
    fi
    rm -f "$temp_file"
    return 1
  fi

  rm -f "$temp_file"
  return 0
}

main() {
  print_box "Theming"
  log STEP "Limine Appearance"

  if [[ -x /usr/bin/limine ]]; then
    if ! keep_sudo_alive; then
      die "Failed to keep sudo alive"
    fi

    local limine_result=0
    configure_limine_options || limine_result=$?
    if [[ "$limine_result" -eq 2 ]]; then
      log SKIP "Limine configuration skipped: $LAST_ERROR"
    elif [[ "$limine_result" -ne 0 ]]; then
      die "Failed to configure Limine options: $LAST_ERROR"
    else
      log INFO "Configured Limine options"
    fi
  else
    log WARN "Unsupported bootloader (only Limine is supported), skipping bootloader theming"
  fi


  log INFO "Limine appearance setup complete"
}

main "$@"
