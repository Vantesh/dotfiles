#!/usr/bin/env bash
{{ if .personal -}}
# 04_quiet_boot.sh - Configure quiet boot parameters
# Exit codes: 0 (success), 1 (failure)

set -euo pipefail

shopt -s nullglob globstar

{{ include ".chezmoitemplates/lib/common.sh" }}
{{ include ".chezmoitemplates/lib/snapboot.sh" }}

QUIET_BOOT_PARAMS="quiet loglevel=3 systemd.show_status=auto rd.udev.log_level=3 vt.cur_default=1 systemd.tpm2_measured_os=0"

if command_exists plymouth; then
  QUIET_BOOT_PARAMS+=" splash"
fi

readonly QUIET_BOOT_PARAMS


main() {
  if [[ ! -x /usr/bin/limine ]]; then
    log WARN "Unsupported bootloader (only Limine is supported), skipping quiet boot setup"
    return 0
  fi

  if ! command_exists mkinitcpio; then
    die 127 "mkinitcpio not found; complete the Limine installation"
  fi

  if ! keep_sudo_alive; then
    die "Failed to keep sudo alive"
  fi
  log STEP "Quiet Boot Configuration"

  if ! ensure_limine_cmdline_defaults; then
    die "Cannot configure quiet boot: $LAST_ERROR"
  fi

  if ! update_limine_cmdline "20-quiet-boot.conf" "$QUIET_BOOT_PARAMS"; then
    die "Failed to write Limine quiet boot config: $LAST_ERROR"
  fi
  log INFO "Updated Limine kernel parameters"

  log INFO "Quiet boot configuration complete"
}

main "$@"

{{ end -}}
