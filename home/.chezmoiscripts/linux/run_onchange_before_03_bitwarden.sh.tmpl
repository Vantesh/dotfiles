#!/usr/bin/env bash
# 03_bitwarden.sh - Install the Bitwarden desktop application
#
# Vault prerequisites and authentication are handled by the earlier
# non-templated before script on every apply.
# Globals:
#   LAST_ERROR - Error message from package installation
# Exit codes: 0 (success), 1 (failure)

{{- if .personal }}

# distro-family: {{ .distroFamily | quote }}

set -euo pipefail
shopt -s nullglob globstar

{{ include ".chezmoitemplates/lib/common.sh" }}
{{ include ".chezmoitemplates/lib/package_manager.sh" }}

if ! install_package "bitwarden-bin"; then
  die "Failed to install Bitwarden desktop application: $LAST_ERROR"
fi

{{- end }}
