#!/usr/bin/env bash

# 99_Finalize.sh - Finalize setup after other scripts
#
# Offers a firmware reboot when Secure Boot setup is enabled but firmware
# Secure Boot is inactive. Other setups retain the normal reboot prompt.
# Unattended applies never reboot automatically.
#
# Globals:
#   SETUP_SECURE_BOOT - Secure Boot opt-in from chezmoi configuration
#   NOCONFIRM, CI - Disable reboot prompts in unattended environments
# Exit codes: 0 (success), 1 (failure)

set -euo pipefail

shopt -s nullglob globstar

{{ include ".chezmoitemplates/lib/common.sh" }}

print_box "Setup Complete"
printf "\n"

readonly SECURE_BOOT_SETUP="${SETUP_SECURE_BOOT:-{{ ternary "1" "0" (get . "setupSecureBoot" | default false) }}}"

reboot_args=(reboot)
reboot_prompt="Would you like to reboot now?"
reboot_log="Rebooting system"
reboot_hint="Reboot skipped. Please reboot manually later to apply all changes."

if [[ "$SECURE_BOOT_SETUP" = "1" ]]; then
  if command_exists sbctl && command_exists jq &&
    secure_boot_status="$(sbctl --json status)" &&
    jq -e '(.secure_boot | type) == "boolean"' <<<"$secure_boot_status" >/dev/null; then
    if jq -e '.secure_boot' <<<"$secure_boot_status" >/dev/null; then
      log INFO "Secure Boot is already enabled in firmware"
    else
      log INFO "Secure Boot setup completed; enable Secure Boot in UEFI firmware settings"
      reboot_args+=(--firmware-setup)
      reboot_prompt="Would you like to reboot into UEFI firmware settings to enable Secure Boot?"
      reboot_log="Rebooting into UEFI firmware settings"
      reboot_hint="Reboot skipped. Run systemctl reboot --firmware-setup later to enable Secure Boot."
    fi
  else
    log WARN "Could not check Secure Boot status; run sudo sbctl status before enabling Secure Boot in UEFI settings"
  fi
fi

if [[ "${NOCONFIRM:-0}" != "1" ]] &&
  [[ -z "${CI:-}" ]] &&
  confirm "$reboot_prompt" "n"; then
  log INFO "$reboot_log"
  systemctl "${reboot_args[@]}"
else
  log INFO "$reboot_hint"
fi
