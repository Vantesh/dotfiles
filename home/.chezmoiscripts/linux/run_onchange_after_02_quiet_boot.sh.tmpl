#!/usr/bin/env bash
# 02_quiet_boot.sh - Configure quiet boot parameters
# Exit codes: 0 (success), 1 (failure)

set -euo pipefail

shopt -s nullglob globstar

{{ include ".chezmoitemplates/lib/common.sh" }}
{{ include ".chezmoitemplates/lib/snapboot.sh" }}

QUIET_BOOT_PARAMS="quiet loglevel=3 systemd.show_status=auto rd.udev.log_level=3 vt.cur_default=1"

if command_exists plymouth; then
  QUIET_BOOT_PARAMS+=" splash"
fi

readonly QUIET_BOOT_PARAMS


main() {
  if [[ ! -x /usr/bin/limine ]]; then
    log WARN "Unsupported bootloader (only Limine is supported), skipping quiet boot setup"
    return 0
  fi

  if ! command_exists mkinitcpio; then
    log WARN "mkinitcpio not found, skipping quiet boot setup"
    return 0
  fi

  if ! keep_sudo_alive; then
    die "Failed to keep sudo alive"
  fi

  print_box "Quiet Boot"
  log STEP "Quiet Boot Configuration"

  if [[ ! -f /etc/limine-entry-tool.d/01-default.conf ]]; then
    if [[ -r /proc/cmdline ]]; then
      local cleaned_params
      cleaned_params="$(sed -E 's/\b(quiet|splash|loglevel=[0-9]+|systemd\.show_status=[a-z]+|rd\.udev\.log_level=[0-9]+|vt\.cur_default=[0-9]+)\b//g; s/[[:space:]]+/ /g; s/^[[:space:]]+//; s/[[:space:]]+$//' /proc/cmdline)"

      if [[ -n "$cleaned_params" ]]; then
        if ! update_limine_cmdline "01-default.conf" "$cleaned_params"; then
          die "Failed to create default Limine config: $LAST_ERROR"
        fi
      fi
    else
      log WARN "/proc/cmdline not readable; cannot create default Limine drop-in"
    fi
  fi

  if ! update_limine_cmdline "20-quiet-boot.conf" --append "$QUIET_BOOT_PARAMS"; then
    die "Failed to write Limine quiet boot config: $LAST_ERROR"
  fi
  log INFO "Updated Limine kernel parameters"

  log INFO "Quiet boot configuration complete"
}

main "$@"
