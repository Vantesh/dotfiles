#!/usr/bin/env bash
# 02_packages.sh - Install packages
# Exit codes: 0 (success), 1 (failure)

# Effective settings not already represented by the rendered package arrays.
# DISTRO_FAMILY: {{ .distroFamily | quote }}
# DISTRO: {{ .chezmoi.osRelease.id | quote }}
# INSTALL_CHAOTIC_AUR: {{ ternary "1" "0" .installChaoticAUR }}
# INSTALL_DRIVERS: {{ ternary "1" "0" .installDrivers }}
# INSTALL_OPTIONAL_PACKAGES: {{ ternary "1" "0" .installOptionalPackages }}
# SETUP_SNAPPER: {{ ternary "1" "0" .setupSnapper }}
# SKIP_PACKAGES: {{ ternary "1" "0" (eq (env "SKIP_PACKAGES") "1") }}

set -euo pipefail

shopt -s nullglob globstar

{{ include ".chezmoitemplates/lib/common.sh" }}
{{ include ".chezmoitemplates/lib/xdg_setup.sh" }}
{{ include ".chezmoitemplates/lib/chaotic_aur.sh" }}
{{ include ".chezmoitemplates/lib/aur_helper.sh" }}
{{ include ".chezmoitemplates/lib/package_manager.sh" }}


if [[ "$(id -u)" -eq 0 ]]; then
  die "Do not run this script as root."
fi

if ! keep_sudo_alive; then
  die "Failed to keep sudo alive"
fi

if [[ "${SKIP_PACKAGES:-0}" == "1" ]]; then
  log INFO "Skipping package installation"
  exit 0
fi

if ! setup_xdg; then
  die "XDG setup failed: $LAST_ERROR"
fi

# Chaotic-AUR setup
if [[ "${INSTALL_CHAOTIC_AUR:-0}" == "1" ]]; then
  if ! chaotic_repo_configured; then
    log STEP "Chaotic-AUR"
    log INFO "Setting up Chaotic-AUR repository"

    if ! setup_chaotic_aur; then
      die "Failed to set up Chaotic-AUR repo: $LAST_ERROR"
    fi

    log INFO "Configured Chaotic-AUR repository"
  fi
else
  log INFO "Skipping Chaotic-AUR setup"
fi

# AUR helper installation
if ! command_exists paru && ! command_exists yay; then
  log STEP "AUR helper"
  log INFO "Installing AUR helper (paru)... this may take a while"

  if ! install_aur_helper; then
    die "Failed to install AUR helper: $LAST_ERROR"
  fi
fi

print_box "Packages"

# ============================================================================
# Core Packages
# ============================================================================
core_pkgs=(
{{- range .packages.core }}
  "{{ . }}"
{{- end }}
  "{{ .defaultShell }}"
)

core_pkgs+=(
{{- range (index .packages.compositor .compositor) }}
  "{{ . }}"
{{- end }}
)

install_group "Core" "${core_pkgs[@]}"

# ============================================================================
# Terminal
# ============================================================================
terminal_pkgs=(
{{- range (index .packages.terminal .terminal) }}
  "{{ . }}"
{{- end }}
)
install_group "Terminal" "${terminal_pkgs[@]}"

# ============================================================================
# CLI Tools
# ============================================================================
cli_pkgs=(
{{- range .packages.cli }}
  "{{ . }}"
{{- end }}
)
install_group "CLI Tools" "${cli_pkgs[@]}"

# ============================================================================
# Theming
# ============================================================================
theme_pkgs=(
{{- range .packages.theming }}
  "{{ . }}"
{{- end }}
)
install_group "Theming" "${theme_pkgs[@]}"

# ============================================================================
# Fonts
# ============================================================================
font_pkgs=(
{{- range .packages.fonts }}
  "{{ . }}"
{{- end }}
)
install_group "Fonts" "${font_pkgs[@]}"

# ============================================================================
# Drivers
# ============================================================================
if [[ "${INSTALL_DRIVERS:-1}" == "1" ]]; then
  drivers=(
{{- range .packages.drivers.base }}
    "{{ . }}"
{{- end }}
  )

  # Kernel headers
  kernel_version=$(uname -r)
  case "$kernel_version" in
    *-zen*)     drivers+=("{{ .packages.drivers.kernelHeaders.zen }}") ;;
    *-lts*)     drivers+=("{{ .packages.drivers.kernelHeaders.lts }}") ;;
    *-cachyos*) drivers+=("{{ .packages.drivers.kernelHeaders.cachyos }}") ;;
    *)          drivers+=("{{ .packages.drivers.kernelHeaders.default }}") ;;
  esac

  # GPU-specific drivers
  gpu_info=$(lspci -nn | grep -Ei "VGA|3D|Display")

  # NVIDIA drivers
  if [[ $gpu_info == *"NVIDIA"* ]]; then
    drivers+=(
{{- range .packages.drivers.nvidia }}
      "{{ . }}"
{{- end }}
    )

    # Select NVIDIA variant based on GPU generation
    nvidia_variant=""
    if echo "$gpu_info" | grep -q -E "RTX [2-9][0-9]|GTX 16"; then
      # Turing+ (RTX 20xx, GTX 16xx): Use open kernel modules
      nvidia_variant="nvidia-open-dkms"
    else
      # Pascal/Maxwell/older (GTX 10xx and older): Use legacy 580xx
      nvidia_variant="nvidia-580xx-dkms"
    fi

    # Skip variant selection on certain distros
    case "${DISTRO,,}" in
      cachyos|garuda)
        log SKIP "Skipping NVIDIA variant selection"
        ;;
      *)
        drivers+=("${nvidia_variant}")
        ;;
    esac
  fi

  # AMD drivers
  if [[ $gpu_info == *"AMD/ATI"* ]]; then
    drivers+=(
{{- range .packages.drivers.amd }}
      "{{ . }}"
{{- end }}
    )
  fi

  # Intel drivers
  if [[ $gpu_info == *"Intel"* ]]; then
    drivers+=(
{{- range .packages.drivers.intel }}
      "{{ . }}"
{{- end }}
    )
  fi

  install_group "Drivers" "${drivers[@]}"
else
  log INFO "Skipping driver installation"
fi

# ============================================================================
# Laptop Packages
# ============================================================================
if is_laptop; then
  laptop_pkgs=(
{{- range .packages.laptop }}
    "{{ . }}"
{{- end }}
  )
  install_group "Laptop" "${laptop_pkgs[@]}"
fi

# ============================================================================
# Optional Packages
# ============================================================================
if [[ "${INSTALL_OPTIONAL_PACKAGES:-1}" == "1" ]]; then
  opt_pkgs=(
{{- range .packages.optional }}
    "{{ . }}"
{{- end }}
  )
  install_group "Optional" "${opt_pkgs[@]}"
else
  log INFO "Skipping optional packages"
fi

# ============================================================================
# Snapper Packages
# ============================================================================
if [[ "${SETUP_SNAPPER:-1}" != "1" ]]; then
  log INFO "Skipping Snapper installation"
elif [[ ! -x /usr/bin/limine ]]; then
  log WARN "Unsupported bootloader (only Limine is supported), skipping Snapper installation"
elif ! command_exists mkinitcpio; then
  log WARN "mkinitcpio not found, skipping Snapper installation"
else
  snapper_pkgs=(
{{- range .packages.snapper.common }}
    "{{ . }}"
{{- end }}
{{- range .packages.snapper.limine }}
    "{{ . }}"
{{- end }}
  )

  install_group "Snapper" "${snapper_pkgs[@]}"
fi
