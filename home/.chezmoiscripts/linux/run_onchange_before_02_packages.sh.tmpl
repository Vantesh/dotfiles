#!/usr/bin/env bash
# Only package declarations and orchestration determine eligibility, not unrelated
# logging/authentication helpers or service declarations.
# mise/config.toml: {{ include "../mise/config.toml" | sha256sum }}
# mise/conf.d/packages.toml: {{ include "../mise/conf.d/packages.toml" | sha256sum }}
# packages.py: {{ include ".chezmoitemplates/packages.py" | sha256sum }}
set -euo pipefail

if [[ "$(id -u)" -eq 0 ]]; then
  printf 'ERROR: Run package setup as a regular user.\n' >&2
  exit 1
fi
exec /usr/bin/python3 -B {{ joinPath .chezmoi.sourceDir ".chezmoitemplates/packages.py" | quote }} \
  --root {{ .chezmoi.workingTree | quote }} --distro {{ .chezmoi.osRelease.id | quote }}{{ if .personal }} --personal{{ end }}
