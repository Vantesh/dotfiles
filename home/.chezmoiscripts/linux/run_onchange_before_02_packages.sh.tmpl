#!/usr/bin/env bash
# 02_packages.sh - Install packages
# Exit codes: 0 (success), 1 (failure)

# Fixed declarations are outside the chezmoi source root; include their content
# hash so changes make this run_onchange script eligible to run again.
# mise/config.toml: {{ include "../mise/config.toml" | sha256sum }}
# mise/conf.d/packages.toml: {{ include "../mise/conf.d/packages.toml" | sha256sum }}
# DISTRO_FAMILY: {{ .distroFamily | quote }}
# DISTRO: {{ .chezmoi.osRelease.id | quote }}

# INSTALL_DRIVERS: {{ ternary "1" "0" .installDrivers }}
# SETUP_SNAPPER: {{ ternary "1" "0" .setupSnapper }}
# SKIP_PACKAGES: {{ ternary "1" "0" (eq (env "SKIP_PACKAGES") "1") }}

set -euo pipefail

{{ include ".chezmoitemplates/lib/common.sh" }}
{{ include ".chezmoitemplates/lib/xdg_setup.sh" }}
{{ include ".chezmoitemplates/lib/aur_helper.sh" }}


if [[ "$(id -u)" -eq 0 ]]; then
  die "Do not run this script as root."
fi

if [[ "${SKIP_PACKAGES:-0}" == "1" ]]; then
  log INFO "Skipping package installation"
  exit 0
fi

if ! keep_sudo_alive; then
  die "Failed to keep sudo alive"
fi

if ! setup_xdg; then
  die "XDG setup failed: $LAST_ERROR"
fi

if ! setup_chaotic_aur; then
  die "Failed to set up Chaotic-AUR: $LAST_ERROR"
fi

if ! install_aur_helper; then
  die "Failed to install AUR helper: $LAST_ERROR"
fi

print_box "Packages"

package_envs={{ ternary "packages,personal" "packages" .personal | quote }}
nvidia_branch=""

# Drivers
if [[ "${INSTALL_DRIVERS:-1}" == "1" ]]; then
  package_envs+=",driver-utils"

  # Use installed package versions, not the release still running before reboot.
  # Pacman enforces exact split-package targets; mise cannot install version pins.
  header_targets=()
  installed_packages=$(pacman -Q) || die "Failed to query installed packages"
  while read -r kernel kernel_version; do
    case "$kernel" in
      linux|linux-zen|linux-lts|linux-cachyos) header="$kernel-headers" ;;
      *) continue ;;
    esac

    header_version=$(awk -v name="$header" '$1 == name { print $2 }' <<< "$installed_packages")
    if [[ -z "$header_version" ]]; then
      header_targets+=("$kernel=$kernel_version" "$header=$kernel_version")
    elif [[ "$header_version" != "$kernel_version" ]]; then
      die "$kernel $kernel_version does not match $header $header_version. Reconcile the kernel/header pair manually using a supported full-system upgrade; setup will not change either package."
    fi
  done <<< "$installed_packages"

  if [[ ${#header_targets[@]} -gt 0 ]]; then
    log STEP "Installing missing kernel headers"
    # No refresh or system upgrade: unavailable exact versions must fail.
    if ! sudo pacman -S --needed --noconfirm -- "${header_targets[@]}"; then
      die "Failed to install matching kernel headers. Complete a supported full-system upgrade with the required headers, then rerun setup; setup will not upgrade kernels automatically."
    fi
    for target in "${header_targets[@]}"; do
      installed_package=$(pacman -Q -- "${target%%=*}") || die "Failed to verify $target"
      [[ "$installed_package" == "${target/=/ }" ]] || die "Expected $target after header installation, found $installed_package; reconcile the kernel/header pair before rerunning setup."
    done
  fi

  gpu_info=$(lspci -nn) || die "Failed to inspect PCI controllers"

  nvidia_unknown=false
  while IFS= read -r gpu; do
    # PCI class 03 is display; the vendor ID also works with unnamed devices.
    [[ "$gpu" =~ \[03[[:xdigit:]]{2}\]: && "$gpu" =~ \[10de:[[:xdigit:]]{4}\] ]] || continue
    if [[ "$gpu" =~ (^|[^[:alnum:]_])(GM|GP|GV|TU|GA|AD|GB)[0-9]{3}[A-Z]*([^[:alnum:]_]|$) ]]; then
      case "${BASH_REMATCH[2]}" in
        GM|GP|GV) branch=legacy ;; # R580 is the last Maxwell/Pascal/Volta branch.
        *)        branch=current ;;
      esac
      nvidia_branch="${nvidia_branch:-$branch}"
      [[ "$nvidia_branch" == "$branch" ]] || nvidia_branch=mixed
    else
      log WARN "Unrecognized NVIDIA display architecture; skipping automatic NVIDIA provisioning: $gpu"
      nvidia_unknown=true
    fi
  done <<< "$gpu_info"

  if [[ "$nvidia_branch" == mixed ]]; then
    log WARN "Mixed legacy/current NVIDIA GPUs; configure drivers manually"
  fi
  if [[ "$nvidia_unknown" == true || "$nvidia_branch" == mixed ]]; then
    nvidia_branch=""
  fi

  nvidia_module_installed=false
  if [[ -n "$nvidia_branch" ]]; then
    # Complete matching stacks, but never switch installed driver families.
    nvidia_installed=$(awk '$1 ~ /^(lib32-)?(nvidia(-[0-9]+xx)?(-utils|-settings|-dkms|-lts)?|nvidia-open(-dkms|-lts)?|opencl-nvidia(-[0-9]+xx)?)$/ {print $1}' <<< "$installed_packages")
    while IFS= read -r package; do
      [[ -n "$package" ]] || continue
      case "$nvidia_branch:${package#lib32-}" in
        legacy:nvidia-580xx|legacy:nvidia-580xx-dkms|legacy:nvidia-580xx-lts|current:nvidia-open|current:nvidia-open-dkms|current:nvidia-open-lts)
          nvidia_module_installed=true ;;
        legacy:nvidia-580xx-utils|legacy:nvidia-580xx-settings|legacy:opencl-nvidia-580xx|current:nvidia-utils|current:nvidia-settings|current:opencl-nvidia)
          ;;
        *)
          die "Installed NVIDIA package '$package' conflicts with the detected $nvidia_branch GPU driver family. Resolve the driver stack manually before rerunning; setup will not replace installed drivers."
          ;;
      esac
    done <<< "$nvidia_installed"
  fi

  if [[ "$nvidia_branch" == legacy ]]; then
    package_envs+=",nvidia-legacy"
  elif [[ "$nvidia_branch" == current ]]; then
    package_envs+=",nvidia-current"
  fi
  if [[ -n "$nvidia_branch" ]]; then
    case "${DISTRO,,}" in
      cachyos|garuda)
        log SKIP "Leaving NVIDIA modules to the distribution"
        pacman -Dk >/dev/null || die "Broken package dependencies; complete supported system maintenance before rerunning setup."
        ;;
      *)
        # Preserve a matching fixed-kernel or DKMS module already installed.
        if [[ "$nvidia_module_installed" == false ]]; then
          if [[ "$nvidia_branch" == legacy ]]; then
            package_envs+=",nvidia-legacy-dkms"
          else
            package_envs+=",nvidia-open"
          fi
        fi
        ;;
    esac
  fi

  # Intel drivers
  if [[ $gpu_info == *"Intel"* ]]; then
    package_envs+=",intel"
  fi
else
  log INFO "Skipping driver installation"
fi

# Fingerprint packages are independent of graphics driver provisioning.
fingerprint_goodix=false
for usb_device in /sys/bus/usb/devices/*; do
  [[ -r "$usb_device/idVendor" && -r "$usb_device/idProduct" ]] || continue
  if [[ $(< "$usb_device/idVendor") == 27c6 && $(< "$usb_device/idProduct") == 5395 ]]; then
    fingerprint_goodix=true
    break
  fi
done
if [[ "$fingerprint_goodix" == true ]]; then
  package_envs+=",fingerprint-goodix"
fi

# Laptop packages
if is_laptop; then
  package_envs+=",laptop"
fi

# Limine and mkinitcpio packages
if [[ ! -x /usr/bin/limine ]]; then
  log WARN "Unsupported bootloader (only Limine is supported), skipping Limine and mkinitcpio installation"
elif ! command_exists mkinitcpio; then
  log WARN "mkinitcpio not found, skipping Limine and mkinitcpio installation"
else
  package_envs+=",limine-mkinitcpio"
fi

# Snapper packages
if [[ "${SETUP_SNAPPER:-1}" != "1" ]]; then
  log INFO "Skipping Snapper installation"
elif [[ ! -x /usr/bin/limine ]]; then
  log WARN "Unsupported bootloader (only Limine is supported), skipping Snapper installation"
elif ! command_exists mkinitcpio; then
  log WARN "mkinitcpio not found, skipping Snapper installation"
else
  package_envs+=",snapper"
fi

# Zed's generic vulkan-driver dependency can otherwise select nvidia-utils,
# even when NVIDIA provisioning is skipped. Do not choose a replacement driver.
if [[ "$package_envs" != *,intel* && "$package_envs" != *,nvidia-current* && "$nvidia_branch" != legacy ]]; then
  pacman -T vulkan-driver >/dev/null || die "No installed Vulkan provider; baseline dependencies could select NVIDIA utilities. Install a compatible Vulkan provider manually, then rerun setup."
fi

# Load only this repository's declarations, not unrelated host configs.
# Use the working tree because chezmoi may execute this script from a temp file.
# Change directory before launch: mise reads early .miserc config before --cd.
if ! (
  cd {{ .chezmoi.workingTree | quote }} || exit 1
  unset MISE_CONFIG_FILE MISE_GLOBAL_CONFIG_FILE MISE_SYSTEM_CONFIG_FILE
  export MISE_CONFIG_DIR=/dev/null MISE_SYSTEM_CONFIG_DIR=/dev/null
  export MISE_AUTO_ENV=false MISE_CEILING_PATHS={{ dir .chezmoi.workingTree | quote }}
  export MISE_TRUSTED_CONFIG_PATHS={{ joinPath .chezmoi.workingTree "mise" | quote }}


  # Establish the legacy provider before settings and generic helper dependencies.
  # Explicitly stop on failure: this subshell is tested by the enclosing if.
  if [[ "$nvidia_branch" == legacy ]]; then
    log STEP "Installing NVIDIA 580xx utilities"
    mise --env nvidia-legacy-utils bootstrap packages apply --yes || exit 1
  fi

  mise --env "$package_envs" bootstrap packages apply --yes
); then
  die "Failed to install selected packages with mise"
fi
